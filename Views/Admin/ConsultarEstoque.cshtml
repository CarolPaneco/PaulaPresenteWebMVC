@model List<PaulaPresentesWebMVC.Models.Produto>

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <title>Consultar Estoque</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />


        <script>

        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {

                    colors: {

                        "surface-container-high": "#e8e8e8",
                        "primary-container": "#800020",
                        "surface-container-lowest": "#ffffff",
                        "outline": "#8c7071",
                        "secondary-container": "#fed65b",
                        "surface-bright": "#f9f9f9",
                        "surface": "#f9f9f9",
                        "outline-variant": "#e0bfbf",
                        "surface-container-low": "#f3f3f3",
                        "on-surface": "#1b1b1b",
                        "surface-container-highest": "#e2e2e2",
                        "surface-container": "#eeeeee",
                        "on-surface-variant": "#584141",
                        "background": "#f9f9f9",
                        "primary": "#570013",
                        "on-primary": "#ffffff",
                        "error": "#ba1a1a",
                        "success": "#166534"
                    },

                    fontFamily: {
                        "body-md": ["Inter"],
                        "headline-lg": ["Noto Serif"],
                        "headline-md": ["Noto Serif"]
                    }
                }
            }
        }

    </script>

</head>

<body class="min-h-screen font-body-md bg-surface">

    <header class="h-20 bg-surface-container-lowest border-b border-surface-container flex items-center justify-between px-16 sticky top-0 z-40">

        <div class="flex items-center gap-4">

            <span class="font-headline-md text-primary text-2xl tracking-tight">
                Paula Presentes
            </span>

            <span class="text-outline text-xs uppercase tracking-widest bg-surface-container px-3 py-1 rounded-full">
                Painel Admin
            </span>

        </div>

        <a href="/Admin/Produtos"
           class="flex items-center gap-2 text-outline hover:text-primary transition-colors duration-300">

            <span class="material-symbols-outlined text-xl">
                arrow_back
            </span>

            <span class="uppercase text-xs tracking-widest">
                Voltar
            </span>

        </a>

    </header>

    <div class="max-w-7xl mx-auto">

        <div class="mb-10">

            <h1 class="text-5xl font-bold mt-5 text-[#570013]">
                Consultar Estoque
            </h1>

            <p class="text-gray-500 mt-4 text-lg">
                Produtos disponíveis no estoque
            </p>

        </div>

        <form method="get" class="mb-10">

            <input type="text"
                   name="pesquisa"
                   placeholder="Pesquisar por código, nome, categoria ou cor"
                   class="w-full bg-white border border-gray-300 rounded-2xl p-5 shadow-sm" />

        </form>

        <div class="bg-white rounded-3xl shadow overflow-hidden">

            <table class="w-full">

                <thead class="bg-[#570013] text-white">

                    <tr>

                        <th class="p-6 text-left">Produto</th>
                        <th class="p-6 text-left">Categoria</th>
                        <th class="p-6 text-left">Cor</th>
                        <th class="p-6 text-left">Estoque</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="border-b hover:bg-gray-50">

                            <td class="p-6">@item.Nome</td>

                            <td class="p-6">@item.Categoria</td>

                            <td class="p-6">@item.Cor</td>

                            <td class="p-6 font-bold">

                                @item.QuantidadeEstoque

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</body>

</html>