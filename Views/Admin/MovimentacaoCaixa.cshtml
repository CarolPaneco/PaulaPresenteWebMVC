@model List<PaulaPresentesWebMVC.Models.MovimentacaoCaixa>

@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>Movimentação Caixa</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap"
        rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script>

        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {

                    colors: {

                        "surface-container-high": "#e8e8e8",
                        "primary-container": "#800020",
                        "surface-container-lowest": "#ffffff",
                        "outline": "#8c7071",
                        "secondary-container": "#fed65b",
                        "surface-bright": "#f9f9f9",
                        "surface": "#f9f9f9",
                        "outline-variant": "#e0bfbf",
                        "surface-container-low": "#f3f3f3",
                        "on-surface": "#1b1b1b",
                        "surface-container-highest": "#e2e2e2",
                        "surface-container": "#eeeeee",
                        "on-surface-variant": "#584141",
                        "background": "#f9f9f9",
                        "primary": "#570013",
                        "on-primary": "#ffffff",
                        "error": "#ba1a1a",
                        "success": "#166534"
                    },

                    fontFamily: {
                        "body-md": ["Inter"],
                        "headline-lg": ["Noto Serif"],
                        "headline-md": ["Noto Serif"]
                    }
                }
            }
        }

    </script>

</head>

<body class="bg-surface font-body min-h-screen">

    <!-- HEADER -->
    <header class="h-20 bg-surface-container-lowest border-b border-surface-container flex items-center justify-between px-16 sticky top-0 z-40">

        <div class="flex items-center gap-4">

            <span class="font-headline-md text-primary text-2xl tracking-tight">
                Paula Presentes
            </span>

            <span class="text-outline text-xs uppercase tracking-widest bg-surface-container px-3 py-1 rounded-full">
                Painel Admin
            </span>

        </div>

        <a href="/Admin"
           class="flex items-center gap-2 text-outline hover:text-primary transition-colors duration-300">

            <span class="material-symbols-outlined text-xl">
                arrow_back
            </span>

            <span class="uppercase text-xs tracking-widest">
                Voltar
            </span>

        </a>

    </header>

    <main class="max-w-[1600px] mx-auto px-16 py-16">

        <!-- TOPO -->
        <div class="flex justify-between items-center mb-12">

            <div>

                <h1 class="text-5xl font-bold text-on-surface font-headline">
                    Movimentação Caixa
                </h1>

                <p class="text-on-surface-variant mt-3 text-lg">
                    Controle financeiro completo da loja
                </p>

            </div>

            <div class="flex gap-4">

                <button onclick="abrirEntrada()"
                    class="bg-green-600 hover:bg-green-700 text-white px-8 py-5 rounded-2xl font-bold text-lg shadow-xl transition">

                    Nova Entrada

                </button>

                <button onclick="abrirSaida()"
                    class="bg-red-600 hover:bg-red-700 text-white px-8 py-5 rounded-2xl font-bold text-lg shadow-xl transition">

                    Nova Saída

                </button>

            </div>

        </div>

        <!-- CARDS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">

            <!-- ENTRADAS -->
            <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-xl border border-outline-variant">

                <div class="flex justify-between items-center">

                    <div>

                        <p class="text-on-surface-variant text-lg">
                            Entradas
                        </p>

                        <h2 class="text-5xl font-bold text-green-600 mt-4">

                            R$ @(((decimal)(ViewBag.TotalEntradas ?? 0)).ToString("N2"))

                        </h2>

                    </div>

                    <span class="material-symbols-outlined text-6xl text-green-600">
                        trending_up
                    </span>

                </div>

            </div>

            <!-- SAÍDAS -->
            <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-xl border border-outline-variant">

                <div class="flex justify-between items-center">

                    <div>

                        <p class="text-on-surface-variant text-lg">
                            Saídas
                        </p>

                        <h2 class="text-5xl font-bold text-red-600 mt-4">

                            R$ @(((decimal)(ViewBag.TotalSaidas ?? 0)).ToString("N2"))

                        </h2>

                    </div>

                    <span class="material-symbols-outlined text-6xl text-red-600">
                        trending_down
                    </span>

                </div>

            </div>

            <!-- SALDO -->
            <div class="bg-primary text-white rounded-3xl p-8 shadow-xl">

                <div class="flex justify-between items-center">

                    <div>

                        <p class="opacity-80 text-lg">
                            Saldo Atual
                        </p>

                        <h2 class="text-5xl font-bold mt-4">

                            R$ @(((decimal)(ViewBag.Saldo ?? 0)).ToString("N2"))

                        </h2>

                    </div>

                    <span class="material-symbols-outlined text-6xl">
                        account_balance_wallet
                    </span>

                </div>

            </div>

        </div>

        <!-- FILTRO -->
        <form method="get"
            class="bg-surface-container-lowest rounded-3xl p-8 shadow-xl border border-outline-variant mb-12">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <div>

                    <label class="font-semibold text-on-surface">
                        Data Inicial
                    </label>

                    <input type="date" name="dataInicial"
                        class="w-full border border-gray-300 rounded-2xl p-4 mt-3 focus:ring-2 focus:ring-primary" />

                </div>

                <div>

                    <label class="font-semibold text-on-surface">
                        Data Final
                    </label>

                    <input type="date" name="dataFinal"
                        class="w-full border border-gray-300 rounded-2xl p-4 mt-3 focus:ring-2 focus:ring-primary" />

                </div>

                <div class="flex items-end">

                    <button
                        class="w-full bg-primary hover:opacity-90 text-white rounded-2xl p-4 font-bold text-lg shadow-lg transition">

                        Filtrar Período

                    </button>

                </div>

            </div>

        </form>

        <!-- TABELA -->
        <div class="bg-surface-container-lowest rounded-3xl shadow-xl overflow-hidden border border-outline-variant">

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="bg-primary text-white">

                        <tr>

                            <th class="p-6 text-left text-lg">
                                Tipo
                            </th>

                            <th class="p-6 text-left text-lg">
                                Categoria
                            </th>

                            <th class="p-6 text-left text-lg">
                                Descrição
                            </th>

                            <th class="p-6 text-left text-lg">
                                Valor
                            </th>

                            <th class="p-6 text-left text-lg">
                                Data
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="border-b hover:bg-gray-50 transition">

                                <td class="p-6">

                                    @if (item.Tipo == "ENTRADA")
                                    {
                                        <span class="bg-green-100 text-green-700 px-5 py-2 rounded-2xl font-bold">

                                            Entrada

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-red-100 text-red-700 px-5 py-2 rounded-2xl font-bold">

                                            Saída

                                        </span>
                                    }

                                </td>

                                <td class="p-6 font-medium">
                                    @item.Categoria
                                </td>

                                <td class="p-6 text-on-surface-variant">
                                    @item.Descricao
                                </td>

                                <td class="p-6 font-bold text-xl">

                                    R$ @item.Valor.ToString("N2")

                                </td>

                                <td class="p-6">

                                    @item.DataMovimentacao.ToString("dd/MM/yyyy HH:mm")

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </main>

    <!-- POPUP ENTRADA -->
    <div id="popupEntrada"
        class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center z-50">

        <div class="bg-surface-container-lowest rounded-3xl p-10 w-[550px] shadow-2xl">

            <div class="flex justify-between items-center mb-8">

                <h2 class="text-4xl font-bold font-headline text-green-700">
                    Nova Entrada
                </h2>

                <button onclick="fecharEntrada()">

                    <span class="material-symbols-outlined text-4xl">
                        close
                    </span>

                </button>

            </div>

            <form method="post" action="/Admin/NovaEntrada">

                <div class="space-y-6">

                    <div>

                        <label class="font-semibold">
                            Categoria
                        </label>

                        <select name="Categoria" class="w-full border border-gray-300 rounded-2xl p-4 mt-3">

                            <option>Venda</option>
                            <option>Investimento</option>
                            <option>Recebimento</option>
                            <option>Outros</option>

                        </select>

                    </div>

                    <div>

                        <label class="font-semibold">
                            Descrição
                        </label>

                        <textarea name="Descricao"
                            class="w-full border border-gray-300 rounded-2xl p-4 mt-3 h-32"></textarea>

                    </div>

                    <div>

                        <label class="font-semibold">
                            Valor
                        </label>

                        <input type="text" name="Valor" placeholder="R$ 0,00"
                            class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                    </div>

                </div>

                <button
                    class="w-full bg-green-600 hover:bg-green-700 text-white py-5 rounded-2xl font-bold text-xl mt-8 transition">

                    Salvar Entrada

                </button>

            </form>

        </div>

    </div>

    <!-- POPUP SAÍDA -->
    <div id="popupSaida"
        class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center z-50">

        <div class="bg-surface-container-lowest rounded-3xl p-10 w-[550px] shadow-2xl">

            <div class="flex justify-between items-center mb-8">

                <h2 class="text-4xl font-bold font-headline text-red-700">
                    Nova Saída
                </h2>

                <button onclick="fecharSaida()">

                    <span class="material-symbols-outlined text-4xl">
                        close
                    </span>

                </button>

            </div>

            <form method="post" action="/Admin/NovaSaida">

                <div class="space-y-6">

                    <!-- CATEGORIA -->
                    <div>
                        <label class="font-semibold">Categoria</label>

                        <select name="Categoria" required class="w-full border border-gray-300 rounded-2xl p-4 mt-3">

                            <option value="">Selecione</option>
                            <option value="Fornecedor">Fornecedor</option>
                            <option value="Aluguel">Aluguel</option>
                            <option value="Funcionário">Funcionário</option>
                            <option value="Manutenção">Manutenção</option>
                            <option value="Outros">Outros</option>

                        </select>
                    </div>

                    <!-- DESCRIÇÃO -->
                    <div>
                        <label class="font-semibold">Descrição</label>

                        <textarea name="Descricao" required
                            class="w-full border border-gray-300 rounded-2xl p-4 mt-3 h-32"></textarea>
                    </div>

                    <!-- VALOR -->
                    <div>
                        <label class="font-semibold">Valor</label>

                        <input type="number" step="0.01" name="Valor" id="valor" required
                            class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                        <!-- VISUAL FORMATADO -->
                        <p id="valorFormatado" class="text-sm text-gray-500 mt-2"></p>
                    </div>

                </div>

                <button
                    class="w-full bg-red-600 hover:bg-red-700 text-white py-5 rounded-2xl font-bold text-xl mt-8 transition">

                    Salvar Saída

                </button>

            </form>

        </div>

    </div>

    <script>

        function abrirEntrada() {
            document.getElementById("popupEntrada").classList.remove("hidden");
        }

        function fecharEntrada() {
            document.getElementById("popupEntrada").classList.add("hidden");
        }

        function abrirSaida() {
            document.getElementById("popupSaida").classList.remove("hidden");
        }

        function fecharSaida() {
            document.getElementById("popupSaida").classList.add("hidden");
        }

        // 🔥 COLOCA AQUI EMBAIXO (IMPORTANTE)
        const input = document.getElementById("valor");
        const label = document.getElementById("valorFormatado");

        input.addEventListener("input", function () {
            let valor = parseFloat(this.value);

            if (isNaN(valor)) {
                label.innerText = "";
                return;
            }

            label.innerText = valor.toLocaleString("pt-BR", {
                style: "currency",
                currency: "BRL"
            });
        });

    </script>

</body>

</html>