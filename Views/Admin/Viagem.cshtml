@model List<PaulaPresentesWebMVC.Models.Viagem>

@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta content="width=device-width, initial-scale=1.0"
          name="viewport" />

    <title>Controle de Viagens</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
          rel="stylesheet" />

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#570013",
                        surface: "#f9f9f9",
                        card: "#ffffff",
                        outline: "#e5e5e5",
                        muted: "#6b7280",
                        success: "#15803d",
                        danger: "#b91c1c"
                    },

                    fontFamily: {
                        body: ["Inter"],
                        title: ["Noto Serif"]
                    }
                }
            }
        }
    </script>

    <style>

        body {
            background: #f9f9f9;
            color: #111827;
            -webkit-font-smoothing: antialiased;
        }

        .card-shadow {
            box-shadow: 0px 4px 20px rgba(0,0,0,0.04);
            transition: all .3s ease;
        }

        .card-shadow:hover {
            transform: translateY(-2px);
            box-shadow: 0px 10px 30px rgba(0,0,0,0.06);
        }

        .material-symbols-outlined {
            font-variation-settings:
                'FILL' 0,
                'wght' 300,
                'GRAD' 0,
                'opsz' 24;
        }

    </style>

</head>

<body class="min-h-screen bg-surface font-body">

    <!-- HEADER -->
    <header class="h-20 bg-white border-b border-outline px-16 flex items-center justify-between sticky top-0 z-50">

        <div class="flex items-center gap-4">

            <h1 class="text-2xl font-bold text-primary">
                Paula Presentes
            </h1>

            <span class="bg-gray-100 px-4 py-1 rounded-full text-xs uppercase tracking-widest text-gray-500">

                Painel Admin

            </span>

        </div>

        <a href="/Admin"
           class="bg-primary text-white px-6 py-3 rounded-2xl font-semibold hover:opacity-90 transition">

            Voltar

        </a>

    </header>

    <main class="max-w-[1440px] mx-auto px-16 py-16">

        <!-- TOPO -->
        <section class="flex flex-col lg:flex-row justify-between items-end gap-8 mb-14">

            <div>

                <h1 class="text-5xl font-bold font-title text-gray-900">

                    Controle de Viagens

                </h1>

                <p class="text-gray-500 mt-3 text-lg">

                    Gestão de viagens, custos e compras

                </p>

            </div>

            <div class="text-right">

                <p class="uppercase tracking-widest text-xs text-gray-500 mb-2">

                    Data Atual

                </p>

                <p class="text-2xl font-bold text-primary"
                   id="dataAtual"></p>

            </div>

        </section>

        <!-- FILTRO -->
        <section class="bg-white rounded-[32px] p-10 card-shadow mb-12">

            <div class="flex items-center gap-3 mb-8">

                <span class="material-symbols-outlined text-primary text-4xl">

                    filter_alt

                </span>

                <h2 class="text-3xl font-bold">

                    Filtrar Viagens

                </h2>

            </div>

            <form method="get"
                  action="/Admin/Viagem">

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

                    <div>

                        <label class="font-semibold text-gray-700">

                            Data Inicial

                        </label>

                        <input type="date"
                               name="dataInicial"
                               class="w-full mt-3 border border-outline rounded-2xl p-4 focus:ring-2 focus:ring-primary" />

                    </div>

                    <div>

                        <label class="font-semibold text-gray-700">

                            Data Final

                        </label>

                        <input type="date"
                               name="dataFinal"
                               class="w-full mt-3 border border-outline rounded-2xl p-4 focus:ring-2 focus:ring-primary" />

                    </div>

                    <div>

                        <label class="font-semibold text-gray-700">

                            Período

                        </label>

                        <select name="periodo"
                                class="w-full mt-3 border border-outline rounded-2xl p-4">

                            <option value="">
                                Todos
                            </option>

                            <option value="mes">
                                Último Mês
                            </option>

                            <option value="semestre">
                                Últimos 6 Meses
                            </option>

                            <option value="ano">
                                Último Ano
                            </option>

                        </select>

                    </div>

                    <div class="flex items-end">

                        <button class="w-full bg-primary text-white py-4 rounded-2xl font-bold hover:opacity-90 transition">

                            Filtrar

                        </button>

                    </div>

                </div>

            </form>

        </section>

        <!-- DASHBOARDS -->
        <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8 mb-14">

            <!-- TOTAL -->
            <div class="bg-white rounded-[32px] p-8 card-shadow">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm uppercase tracking-wider">

                            Total Viagens

                        </p>

                        <h2 class="text-5xl font-bold mt-5">

                            @ViewBag.TotalViagens

                        </h2>

                    </div>

                    <span class="material-symbols-outlined text-5xl text-primary">

                        travel

                    </span>

                </div>

            </div>

            <!-- GASTOS -->
            <div class="bg-white rounded-[32px] p-8 card-shadow">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm uppercase tracking-wider">

                            Total Gastos

                        </p>

                        <h2 class="text-4xl font-bold text-danger mt-5">

                            R$ @(((decimal)ViewBag.TotalGastos).ToString("N2"))

                        </h2>

                    </div>

                    <span class="material-symbols-outlined text-5xl text-danger">

                        payments

                    </span>

                </div>

            </div>

            <!-- COMPRAS -->
            <div class="bg-white rounded-[32px] p-8 card-shadow">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm uppercase tracking-wider">

                            Compras

                        </p>

                        <h2 class="text-4xl font-bold text-success mt-5">

                            R$ @(((decimal)ViewBag.TotalCompras).ToString("N2"))

                        </h2>

                    </div>

                    <span class="material-symbols-outlined text-5xl text-success">

                        shopping_bag

                    </span>

                </div>

            </div>

            <!-- MÉDIA -->
            <div class="bg-white rounded-[32px] p-8 card-shadow">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm uppercase tracking-wider">

                            Média Viagem

                        </p>

                        <h2 class="text-4xl font-bold mt-5">

                            R$ @(((decimal)ViewBag.MediaViagem).ToString("N2"))

                        </h2>

                    </div>

                    <span class="material-symbols-outlined text-5xl text-primary">

                        monitoring

                    </span>

                </div>

            </div>

        </section>

        <!-- NOVA VIAGEM -->
        <section class="bg-white rounded-[32px] p-10 card-shadow mb-14">

            <div class="flex items-center gap-4 mb-10">

                <span class="material-symbols-outlined text-primary text-5xl">

                    add_circle

                </span>

                <div>

                    <h2 class="text-4xl font-bold">

                        Nova Viagem

                    </h2>

                    <p class="text-gray-500 mt-1">

                        Registre uma nova viagem e seus custos

                    </p>

                </div>

            </div>

            <form method="post"
                  action="/Admin/NovaViagem">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                    <div>

                        <label class="font-semibold">

                            Data da Viagem

                        </label>

                        <input type="date"
                               required
                               name="DataViagem"
                               class="w-full border border-outline rounded-2xl p-4 mt-3" />

                    </div>

                    <div>

                        <label class="font-semibold">

                            Custo Ida e Volta

                        </label>

                        <input type="number"
                               step="0.01"
                               required
                               name="CustoIdaVolta"
                               class="w-full border border-outline rounded-2xl p-4 mt-3" />

                    </div>

                    <div>

                        <label class="font-semibold">

                            Custo Alimentação

                        </label>

                        <input type="number"
                               step="0.01"
                               required
                               name="CustoAlimentacao"
                               class="w-full border border-outline rounded-2xl p-4 mt-3" />

                    </div>

                    <div>

                        <label class="font-semibold">

                            Valor Total Compra

                        </label>

                        <input type="number"
                               step="0.01"
                               required
                               name="ValorTotalCompra"
                               class="w-full border border-outline rounded-2xl p-4 mt-3" />

                    </div>

                </div>

                <button class="w-full bg-primary text-white py-5 rounded-2xl mt-10 text-xl font-bold hover:opacity-90 transition">

                    Salvar Viagem

                </button>

            </form>

        </section>

        <!-- HISTÓRICO -->
        <section class="bg-white rounded-[32px] overflow-hidden card-shadow">

            <div class="p-10 border-b border-outline">

                <div class="flex items-center gap-4">

                    <span class="material-symbols-outlined text-primary text-5xl">

                        history

                    </span>

                    <div>

                        <h2 class="text-4xl font-bold">

                            Histórico de Viagens

                        </h2>

                        <p class="text-gray-500 mt-1">

                            Todas as viagens registradas no sistema

                        </p>

                    </div>

                </div>

            </div>

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="bg-primary text-white">

                        <tr>

                            <th class="p-6 text-left">
                                Data
                            </th>

                            <th class="p-6 text-left">
                                Ida e Volta
                            </th>

                            <th class="p-6 text-left">
                                Alimentação
                            </th>

                            <th class="p-6 text-left">
                                Compras
                            </th>

                            <th class="p-6 text-left">
                                Total
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition">

                                <td class="p-6 font-semibold">

                                    @item.DataViagem.ToString("dd/MM/yyyy")

                                </td>

                                <td class="p-6">

                                    R$ @item.CustoIdaVolta.ToString("N2")

                                </td>

                                <td class="p-6">

                                    R$ @item.CustoAlimentacao.ToString("N2")

                                </td>

                                <td class="p-6 font-bold text-success">

                                    R$ @item.ValorTotalCompra.ToString("N2")

                                </td>

                                <td class="p-6 text-xl font-bold text-primary">

                                    R$ @item.CustoTotal.ToString("N2")

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </main>

    <script>

        const hoje = new Date();

        const opcoes = {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        };

        document
            .getElementById("dataAtual")
            .innerText =
            hoje.toLocaleDateString("pt-BR", opcoes);

    </script>

</body>

</html>