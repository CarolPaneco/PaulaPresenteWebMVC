@model List<PaulaPresentesWebMVC.Models.Viagem>

@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>Controle de Viagens</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#570013",
                        "on-surface": "#1b1b1b",
                        "surface": "#f9f9f9",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#eeeeee",
                        "outline": "#8c7071",
                        "success": "#166534",
                        "danger": "#ba1a1a"
                    },
                    fontFamily: {
                        "body-md": ["Inter"],
                        "headline-md": ["Noto Serif"]
                    }
                }
            }
        }
    </script>

    <style>
        body { background:#f9f9f9; }
    </style>
</head>

<body class="min-h-screen font-[Inter]">

<!-- HEADER -->
<header class="bg-white border-b sticky top-0 z-40">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between px-4 sm:px-10 lg:px-16 py-4 gap-3">

        <div class="flex items-center gap-3">
            <span class="text-primary text-xl sm:text-2xl font-bold font-[Noto Serif]">
                Paula Presentes
            </span>

            <span class="text-[10px] sm:text-xs uppercase bg-gray-100 px-3 py-1 rounded-full">
                Painel Admin
            </span>
        </div>

        <a href="/Admin"
           class="text-sm flex items-center gap-2 text-gray-500 hover:text-primary">
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            Voltar
        </a>
    </div>
</header>

<main class="max-w-[1440px] mx-auto px-4 sm:px-10 lg:px-16 py-10">

    <!-- TOPO -->
    <section class="flex flex-col lg:flex-row justify-between gap-6 mb-10">

        <div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-on-surface">
                Controle de Viagens
            </h1>
            <p class="text-gray-500 mt-2 sm:mt-3 text-sm sm:text-base">
                Gestão de viagens, custos e compras
            </p>
        </div>

        <div class="text-left lg:text-right">
            <p class="text-xs uppercase text-gray-400">Data Atual</p>
            <p class="text-xl sm:text-2xl font-bold text-primary" id="dataAtual"></p>
        </div>

    </section>

    <!-- FILTRO -->
    <section class="bg-white rounded-2xl p-5 sm:p-10 shadow mb-10">

        <h2 class="text-xl sm:text-3xl font-bold mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">filter_alt</span>
            Filtrar Viagens
        </h2>

        <form method="get" action="/Admin/Viagem">

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

                <input type="date" name="dataInicial"
                       class="border rounded-xl p-3 w-full" />

                <input type="date" name="dataFinal"
                       class="border rounded-xl p-3 w-full" />

                <select name="periodo" class="border rounded-xl p-3 w-full">
                    <option value="">Todos</option>
                    <option value="mes">Último mês</option>
                    <option value="semestre">6 meses</option>
                    <option value="ano">1 ano</option>
                </select>

                <button class="bg-primary text-white rounded-xl py-3 font-bold">
                    Filtrar
                </button>

            </div>

        </form>

    </section>

    <!-- CARDS -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">

        <div class="bg-white p-6 rounded-2xl shadow">
            <p class="text-gray-500 text-sm">Total Viagens</p>
            <h2 class="text-3xl font-bold mt-3">@ViewBag.TotalViagens</h2>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow">
            <p class="text-gray-500 text-sm">Total Gastos</p>
            <h2 class="text-2xl sm:text-3xl font-bold text-danger mt-3">
                R$ @(((decimal)ViewBag.TotalGastos).ToString("N2"))
            </h2>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow">
            <p class="text-gray-500 text-sm">Compras</p>
            <h2 class="text-2xl sm:text-3xl font-bold text-success mt-3">
                R$ @(((decimal)ViewBag.TotalCompras).ToString("N2"))
            </h2>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow">
            <p class="text-gray-500 text-sm">Média Viagem</p>
            <h2 class="text-2xl sm:text-3xl font-bold mt-3">
                R$ @(((decimal)ViewBag.MediaViagem).ToString("N2"))
            </h2>
        </div>

    </section>

    <!-- NOVA VIAGEM -->
    <section class="bg-white p-6 sm:p-10 rounded-2xl shadow mb-10">

        <h2 class="text-2xl sm:text-4xl font-bold mb-6">Nova Viagem</h2>

        <form method="post" action="/Admin/NovaViagem">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">

        <!-- DATA -->
        <div>
            <label class="block font-semibold text-sm sm:text-base text-gray-700">
                Data da Viagem
            </label>

            <input type="date"
                   required
                   name="DataViagem"
                   class="w-full border border-outline rounded-2xl p-3 sm:p-4 mt-2 sm:mt-3 focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <!-- IDA E VOLTA -->
        <div>
            <label class="block font-semibold text-sm sm:text-base text-gray-700">
                Custo Ida e Volta
            </label>

            <input type="number"
                   step="0.01"
                   required
                   name="CustoIdaVolta"
                   class="w-full border border-outline rounded-2xl p-3 sm:p-4 mt-2 sm:mt-3 focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <!-- ALIMENTAÇÃO -->
        <div>
            <label class="block font-semibold text-sm sm:text-base text-gray-700">
                Custo Alimentação
            </label>

            <input type="number"
                   step="0.01"
                   required
                   name="CustoAlimentacao"
                   class="w-full border border-outline rounded-2xl p-3 sm:p-4 mt-2 sm:mt-3 focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <!-- COMPRAS -->
        <div>
            <label class="block font-semibold text-sm sm:text-base text-gray-700">
                Valor Total Compra
            </label>

            <input type="number"
                   step="0.01"
                   required
                   name="ValorTotalCompra"
                   class="w-full border border-outline rounded-2xl p-3 sm:p-4 mt-2 sm:mt-3 focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

    </div>

    <!-- BOTÃO -->
    <button class="w-full bg-primary text-white py-4 sm:py-5 rounded-2xl mt-8 text-base sm:text-xl font-bold hover:opacity-90 transition">
        Salvar Viagem
    </button>

</form>

    </section>

    <!-- HISTÓRICO -->
    <section class="bg-white rounded-2xl shadow overflow-hidden">

        <div class="p-6 sm:p-10 border-b">
            <h2 class="text-2xl sm:text-4xl font-bold">Histórico de Viagens</h2>
        </div>

        <!-- SCROLL MOBILE -->
        <div class="overflow-x-auto">

            <table class="min-w-[700px] w-full">

                <thead class="bg-primary text-white">
                    <tr>
                        <th class="p-4 text-left">Data</th>
                        <th class="p-4 text-left">Ida e Volta</th>
                        <th class="p-4 text-left">Alimentação</th>
                        <th class="p-4 text-left">Compras</th>
                        <th class="p-4 text-left">Total</th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var item in Model)
                {
                    <tr class="border-b hover:bg-gray-50">

                        <td class="p-4">@item.DataViagem.ToString("dd/MM/yyyy")</td>
                        <td class="p-4">R$ @item.CustoIdaVolta.ToString("N2")</td>
                        <td class="p-4">R$ @item.CustoAlimentacao.ToString("N2")</td>
                        <td class="p-4 text-success font-bold">R$ @item.ValorTotalCompra.ToString("N2")</td>
                        <td class="p-4 text-primary font-bold">R$ @item.CustoTotal.ToString("N2")</td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </section>

</main>

<script>
    document.getElementById("dataAtual").innerText =
        new Date().toLocaleDateString("pt-BR", {
            weekday: 'long',
            day: '2-digit',
            month: 'long',
            year: 'numeric'
        });
</script>

</body>
</html>