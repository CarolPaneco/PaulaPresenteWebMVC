@{
    Layout = null;

    var gastosCategoria = ViewBag.GastosCategoria;
    var produtosMaisVendidos = ViewBag.ProdutosMaisVendidos;
    var estoqueBaixo = ViewBag.EstoqueBaixo;
}

<!DOCTYPE html>
<html class="light" lang="pt-br">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Relatório Financeiro</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["Inter"],
                        serif: ["Noto Serif"]
                    }
                }
            }
        }
    </script>

</head>

<body class="bg-[#f9f9f9] min-h-screen font-[Inter]">

<!-- HEADER -->
<header class="h-20 bg-white border-b border-gray-200 flex sm:flex-row items-start sm:items-center justify-between px-4 sm:px-10 lg:px-16 py-4 sticky top-0 z-50 shadow-sm">

    <div class="flex items-center gap-3">

        <span class="font-serif text-primary text-xl sm:text-2xl font-bold">
            Paula Presentes
        </span>

        <span class="text-[10px] sm:text-xs uppercase bg-gray-100 px-3 py-1 rounded-full">
            Painel Admin
        </span>

    </div>

    <a href="/Admin" class="flex items-center gap-2 text-gray-500 hover:text-[#570013] text-sm">
        <span class="material-symbols-outlined text-lg">arrow_back</span>
        Voltar
    </a>

</header>

<main class="max-w-[1700px] mx-auto px-4 sm:px-10 lg:px-16 py-10">

<!-- TITLE -->
<div class="mb-10 sm:mb-12">

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1b1b1b] font-serif">
        Relatório Financeiro
    </h1>

    <p class="text-gray-500 mt-2 sm:mt-4 text-sm sm:text-base lg:text-lg">
        Dashboard completo da empresa
    </p>

</div>

<!-- FILTER -->
<form method="get" class="bg-white rounded-3xl shadow-xl p-6 sm:p-8 mb-10 sm:mb-12">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">

        <div>
            <label class="font-bold">Data Inicial</label>
            <input type="date" name="dataInicial"
                   value="@ViewBag.DataInicial"
                   class="w-full border rounded-2xl p-3 sm:p-4 mt-2 sm:mt-3" />
        </div>

        <div>
            <label class="font-bold">Data Final</label>
            <input type="date" name="dataFinal"
                   value="@ViewBag.DataFinal"
                   class="w-full border rounded-2xl p-3 sm:p-4 mt-2 sm:mt-3" />
        </div>

        <div class="flex items-end">
            <button class="w-full bg-[#570013] text-white rounded-2xl p-3 sm:p-4 font-bold text-lg">
                Filtrar Relatório
            </button>
        </div>

    </div>

</form>

<!-- CARDS -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-10 sm:mb-12">

    <!-- FATURAMENTO -->
    <div class="bg-[#570013] text-white rounded-3xl p-6 sm:p-8 shadow-xl">

        <p class="opacity-80 text-sm sm:text-lg">Faturamento</p>

        <h2 class="text-2xl sm:text-3xl lg:text-5xl font-bold mt-3 sm:mt-4">
            R$ @(((decimal)(ViewBag.Faturamento ?? 0)).ToString("N2"))
        </h2>

    </div>

    <!-- LUCRO -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl">

        <p class="text-gray-500 text-sm sm:text-lg">Lucro</p>

        <h2 class="text-2xl sm:text-3xl lg:text-5xl font-bold text-green-600 mt-3">
            R$ @(((decimal)(ViewBag.Lucro ?? 0)).ToString("N2"))
        </h2>

    </div>

    <!-- GASTOS -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl">

        <p class="text-gray-500 text-sm sm:text-lg">Gastos</p>

        <h2 class="text-2xl sm:text-3xl lg:text-5xl font-bold text-red-600 mt-3">
            R$ @(((decimal)(ViewBag.Saidas ?? 0)).ToString("N2"))
        </h2>

    </div>

</div>

<!-- SEMANA -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mb-10 sm:mb-12">

    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-lg sm:text-2xl font-bold mb-3">Venda Semanal</h2>
        <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#570013]">
            R$ @(((decimal)(ViewBag.VendasSemana ?? 0)).ToString("N2"))
        </p>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-lg sm:text-2xl font-bold mb-3">Gastos Semanais</h2>
        <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-red-600">
            R$ @(((decimal)(ViewBag.GatosSemana ?? 0)).ToString("N2"))
        </p>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-lg sm:text-2xl font-bold mb-3">Lucro Semanal</h2>
        <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-green-600">
            R$ @(((decimal)(ViewBag.LucroSemana ?? 0)).ToString("N2"))
        </p>
    </div>

</div>

<!-- GASTOS POR CATEGORIA -->
<div class="bg-white rounded-3xl shadow-xl p-6 sm:p-10 mb-10 sm:mb-12">

    <h2 class="text-xl sm:text-3xl font-bold mb-6">Gastos por Categoria</h2>

    <div class="space-y-4">

        @foreach (var item in gastosCategoria)
        {
            <div class="flex justify-between items-center border-b pb-3">

                <span class="text-sm sm:text-lg lg:text-xl">
                    @item.Categoria
                </span>

                <span class="text-lg sm:text-2xl font-bold text-red-600">
                    R$ @(((decimal)(item.Valor ?? 0)).ToString("N2"))
                </span>

            </div>
        }

    </div>

</div>

<!-- GRID FINANCEIRO -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-10">

    <!-- FLUXO DE CAIXA -->
    <div class="bg-white rounded-3xl shadow-xl p-6 sm:p-10">

        <h2 class="text-xl sm:text-3xl font-bold mb-8">
            Fluxo de Caixa
        </h2>

        <div class="space-y-5">

            <div class="flex justify-between items-center">

                <span class="text-base sm:text-xl">
                    Entradas
                </span>

                <span class="font-bold text-green-600 text-lg sm:text-2xl">
                    R$ @(((decimal)(ViewBag.Entradas ?? 0)).ToString("N2"))
                </span>

            </div>

            <div class="flex justify-between items-center">

                <span class="text-base sm:text-xl">
                    Saídas
                </span>

                <span class="font-bold text-red-600 text-lg sm:text-2xl">
                    R$ @(((decimal)(ViewBag.Saidas ?? 0)).ToString("N2"))
                </span>

            </div>


            <div class="flex justify-between items-center">

                <span class="font-bold text-lg sm:text-2xl">
                    Saldo
                </span>

                <span class="font-bold text-[#570013] text-xl sm:text-3xl">
                    R$ @(((decimal)(ViewBag.Lucro ?? 0)).ToString("N2"))
                </span>

            </div>

        </div>

    </div>

<!-- GRÁFICO -->
    <div class="bg-white rounded-3xl shadow-xl p-6 sm:p-10">

        <h2 class="text-xl sm:text-3xl font-bold mb-8">
            Fluxo Financeiro do Período
        </h2>

        <div style="height:400px;">
            <canvas id="graficoVendas"></canvas>
        </div>

    </div>

</div>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const labels = @Html.Raw(ViewBag.GraficoLabels);

    const entradas = @Html.Raw(ViewBag.GraficoEntradas);

    const saidas = @Html.Raw(ViewBag.GraficoSaidas);

    new Chart(
        document.getElementById('graficoVendas'),
        {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Entradas',
                        data: entradas,
                        borderWidth: 3,
                        tension: 0.4
                    },
                    {
                        label: 'Saídas',
                        data: saidas,
                        borderWidth: 3,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        }
    );

</script>

</body>
</html>