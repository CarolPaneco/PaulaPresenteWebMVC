@model List<Cliente>

@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap"
        rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#570013",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#eeeeee",
                        "on-surface": "#1b1b1b",
                        "on-surface-variant": "#584141",
                        outline: "#8c7071"
                    },
                    fontFamily: {
                        body: ["Inter"],
                        headline: ["Noto Serif"]
                    }
                }
            }
        }
    </script>
</head>

<body class="min-h-screen bg-[#f9f9f9] text-[#1b1b1b] font-[Inter]">

    <!-- HEADER -->
    <header
        class="sticky top-0 z-40 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6 lg:px-16 py-4">

        <div class="flex items-center gap-3 sm:gap-4">
            <span class="font-serif text-primary text-xl sm:text-2xl font-bold">
                Paula Presentes
            </span>

            <span class="hidden sm:inline text-xs uppercase tracking-widest bg-gray-100 px-3 py-1 rounded-full">
                Painel Admin
            </span>
        </div>

        <a href="/Admin" class="flex items-center gap-2 text-gray-500 hover:text-[#570013] text-sm">
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            Voltar
        </a>

    </header>

    <!-- TOPO (TÍTULO + BUSCA) -->
    <div class="sticky top-16 z-30 bg-[#f9f9f9] border-b border-gray-100">

        <div
            class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#570013]">
                Clientes
            </h1>

            <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">

                <input id="searchInput" onkeyup="filtrarClientes()" placeholder="Buscar cliente..."
                    class="border rounded-xl px-4 py-2 w-full sm:w-72 focus:outline-none" />

                <button onclick="abrirModal()"
                    class="bg-[#570013] text-white px-5 py-2 rounded-xl font-semibold hover:opacity-90 w-full sm:w-auto">
                    + Novo Cliente
                </button>

            </div>

        </div>
    </div>

    <!-- MAIN -->
    <main class="p-4 sm:p-6 lg:p-10 max-w-[1400px] mx-auto">

        <!-- ALERTA -->
        <div class="mb-6 p-4 rounded-xl bg-yellow-100 border border-yellow-300 text-sm sm:text-base">

            🎉 Aniversariantes de hoje:

            @if (ViewBag.Aniversariantes != null && ((List<Cliente>)ViewBag.Aniversariantes).Any())
            {
                foreach (var c in (List<Cliente>)ViewBag.Aniversariantes)
                {
                    <span class="font-bold">@c.Nome</span>
            
                    <br />
                }
            }
            else
            {
                <span class="text-gray-600">Nenhum aniversariante hoje 🎂</span>
            }

        </div>

        <!-- GRID CLIENTES -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">

    @foreach (var c in Model)
    {
        <div class="cliente-card bg-white p-5 sm:p-6 rounded-2xl shadow hover:shadow-lg transition border border-gray-200"
             data-nome="@c.Nome"
             data-telefone="@c.Telefone"
             data-nascimento="@c.DataNascimento?.ToString("dd/MM/yyyy")">

            <!-- NOME -->
            <div class="flex items-start justify-between gap-3">

                <h2 class="text-lg sm:text-xl font-bold text-[#570013]">
                    @c.Nome
                </h2>

                @if (c.ValorDevido > 0)
                {
                    <span class="bg-red-100 text-red-700 text-xs font-bold px-3 py-1 rounded-full">
                        DEVENDO
                    </span>
                }
                else
                {
                    <span class="bg-green-100 text-green-700 text-xs font-bold px-3 py-1 rounded-full">
                        EM DIA
                    </span>
                }

            </div>

            <!-- TELEFONE -->
            <p class="text-sm text-gray-600 mt-4">
                📞 @c.Telefone
            </p>

            <!-- NASCIMENTO -->
            <p class="text-sm text-gray-500 mt-1">
                🎂 @(c.DataNascimento?.ToString("dd/MM/yyyy"))
            </p>

            <!-- VALOR DEVIDO -->
            <div class="mt-5 bg-gray-50 rounded-2xl p-4">

                <p class="text-sm text-gray-500">
                    Valor em aberto
                </p>

                @if (c.ValorDevido > 0)
                {
                    <p class="text-2xl font-bold text-red-600 mt-1">
                        R$ @c.ValorDevido.ToString("N2")
                    </p>
                }
                else
                {
                    <p class="text-2xl font-bold text-green-600 mt-1">
                        R$ 0,00
                    </p>
                }

            </div>

            <!-- AÇÕES -->
            <div class="mt-5 flex flex-col sm:flex-row gap-3">

                <!-- ABATER -->
                <a asp-controller="Cliente"
                   asp-action="Abater"
                   asp-route-id="@c.IdCliente"
                   class="flex-1 text-center bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-xl transition">

                    Abater

                </a>

                <!-- HISTÓRICO -->
                <a asp-controller="Cliente"
                   asp-action="Historico"
                   asp-route-id="@c.IdCliente"
                   class="flex-1 text-center bg-[#570013] hover:bg-[#75001a] text-white font-semibold py-3 rounded-xl transition">

                    Histórico

                </a>

            </div>

        </div>
    }

</div>

    </main>

    <!-- MODAL -->
    <div id="modalCliente" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">

        <div class="bg-white p-6 sm:p-8 rounded-2xl w-full max-w-md">

            <h2 class="text-xl font-bold mb-4">Novo Cliente</h2>

            <form method="post" onsubmit="return validarFormulario()" class="space-y-4">

                <input id="nome" name="Nome" placeholder="Nome" class="w-full border p-3 rounded-xl" />

                <input id="telefone" name="Telefone" placeholder="Telefone" class="w-full border p-3 rounded-xl" />

                <input id="nascimento" type="date" name="DataNascimento" class="w-full border p-3 rounded-xl" />

                <!-- ERRO -->
                <p id="erroForm" class="text-red-600 text-sm hidden">
                    ⚠ Preencha todos os campos antes de salvar.
                </p>

                <div class="flex flex-col sm:flex-row justify-end gap-3 pt-4">

                    <button type="button" onclick="fecharModal()"
                        class="px-4 py-2 bg-gray-300 rounded-xl w-full sm:w-auto">
                        Cancelar
                    </button>

                    <button type="submit" class="px-5 py-2 bg-[#570013] text-white rounded-xl w-full sm:w-auto">
                        Salvar
                    </button>

                </div>

            </form>

        </div>
    </div>

    <!-- JS -->
    <script>

        function abrirModal() {
            document.getElementById("modalCliente").classList.remove("hidden");
        }

        function fecharModal() {
            document.getElementById("modalCliente").classList.add("hidden");
        }

        function filtrarClientes() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let cards = document.querySelectorAll(".cliente-card");

            cards.forEach(card => {
                let nome = card.dataset.nome.toLowerCase();
                let tel = card.dataset.telefone.toLowerCase();
                let nasc = card.dataset.nascimento.toLowerCase();

                card.style.display =
                    nome.includes(input) || tel.includes(input) || nasc.includes(input)
                        ? "block"
                        : "none";
            });
        }


function validarFormulario() {

    const nome = document.getElementById("nome").value.trim();
    const telefone = document.getElementById("telefone").value.trim();
    const nascimento = document.getElementById("nascimento").value;

    const erro = document.getElementById("erroForm");

    if (nome === "" || telefone === "" || nascimento === "") {
        erro.classList.remove("hidden");
        return false; // bloqueia envio
    }

    erro.classList.add("hidden");
    return true; // permite envio
}

    </script>

</body>

</html>