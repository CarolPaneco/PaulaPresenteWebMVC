@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Noto+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container-high": "#e8e8e8",
                        "primary-container": "#800020",
                        "surface-container-lowest": "#ffffff",
                        "outline": "#8c7071",
                        "secondary-container": "#fed65b",
                        "on-error-container": "#93000a",
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed-dim": "#c8c6c2",
                        "surface-bright": "#f9f9f9",
                        "surface": "#f9f9f9",
                        "on-primary-fixed-variant": "#8e0f28",
                        "error": "#ba1a1a",
                        "on-primary-container": "#ff828a",
                        "outline-variant": "#e0bfbf",
                        "tertiary-container": "#3d3d3a",
                        "surface-dim": "#dadada",
                        "on-secondary-fixed": "#241a00",
                        "secondary-fixed-dim": "#e9c349",
                        "secondary-fixed": "#ffe088",
                        "surface-container-low": "#f3f3f3",
                        "primary-fixed-dim": "#ffb3b5",
                        "on-surface": "#1b1b1b",
                        "tertiary": "#282725",
                        "secondary": "#735c00",
                        "on-primary-fixed": "#40000b",
                        "surface-container-highest": "#e2e2e2",
                        "surface-container": "#eeeeee",
                        "surface-tint": "#af2b3e",
                        "on-tertiary-container": "#aaa8a3",
                        "on-secondary": "#ffffff",
                        "inverse-surface": "#303030",
                        "inverse-on-surface": "#f1f1f1",
                        "error-container": "#ffdad6",
                        "on-background": "#1b1b1b",
                        "inverse-primary": "#ffb3b5",
                        "on-surface-variant": "#584141",
                        "background": "#f9f9f9",
                        "tertiary-fixed": "#e5e2dd",
                        "surface-variant": "#e2e2e2",
                        "primary-fixed": "#ffdada",
                        "on-error": "#ffffff",
                        "on-tertiary-fixed-variant": "#474743",
                        "on-secondary-container": "#745c00",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed": "#1c1c19",
                        "primary": "#570013",
                        "on-secondary-fixed-variant": "#574500"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "base": "8px",
                        "stack-sm": "16px",
                        "stack-lg": "80px",
                        "container-max": "1440px",
                        "stack-md": "32px",
                        "margin": "64px",
                        "gutter": "24px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "headline-lg": ["Noto Serif"],
                        "body-lg": ["Inter"],
                        "label-caps": ["Inter"],
                        "headline-md": ["Noto Serif"],
                        "display-lg": ["Noto Serif"]
                    },
                    "fontSize": {
                        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "headline-lg": ["32px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "1", "letterSpacing": "0.1em", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "500" }],
                        "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
    <style>
        body {
            background-color: #f9f9f9;
            color: #1b1b1b;
            -webkit-font-smoothing: antialiased;
        }

        .admin-card-shadow {
            box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.03);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .admin-card-shadow:hover {
            box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.06);
            transform: translateY(-2px);
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="min-h-screen font-body-md bg-surface">
    <!-- Top Status Bar -->
    <header
        class="h-20 bg-surface-container-lowest border-b border-surface-container flex items-center justify-between px-16 sticky top-0 z-40">
        <div class="flex items-center gap-4">
            <span class="font-headline-md text-primary tracking-tight">Paula Presentes</span>
            <span
                class="text-outline text-xs uppercase tracking-widest font-label-caps bg-surface-container px-3 py-1 rounded-full">Painel
                Admin</span>
        </div>
        <div class="flex items-center gap-8">
            <button onclick="window.location.href='/Home/Index'"
                class="flex items-center gap-2 text-outline hover:text-primary transition-colors duration-300">

                <span class="material-symbols-outlined text-xl">logout</span>
                <span class="font-label-caps text-[11px] uppercase tracking-wider">Sair</span>

            </button>
        </div>
    </header>
    <main class="max-w-[1440px] mx-auto px-16 py-stack-lg">
        <!-- Welcome Section -->
        <section class="mb-stack-md flex flex-col md:flex-row justify-between items-end gap-6">
            <div class="space-y-2">
                <h1 class="font-headline-lg text-on-surface">Visão Geral do Hub</h1>
            </div>
            <div class="text-right">
                <p class="text-label-caps text-outline uppercase">Data de hoje</p>
                <p class="font-headline-md text-primary tracking-tighter" id="current-date"></p>
            </div>
        </section>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            <!-- VENDAS -->
            <a href="/Admin/RegistrarVenda"
                class="bg-primary text-white rounded-3xl p-10 min-h-[280px] flex flex-col justify-between hover:scale-105 transition-all duration-300 shadow-xl">

                <div>

                    <span class="material-symbols-outlined text-7xl mb-6">
                        point_of_sale
                    </span>

                    <h2 class="text-3xl font-bold mb-4">
                        Vendas
                    </h2>

                    <p class="text-lg opacity-90 leading-relaxed">
                        Registrar vendas, consultar histórico e visualizar dashboard de faturamento.
                    </p>

                </div>

            </a>

            <!-- PRODUTOS -->
            <a href="/Admin/Produtos"
                class="bg-surface-container-lowest rounded-3xl p-10 min-h-[280px] flex flex-col justify-between hover:scale-105 transition-all duration-300 shadow-xl border border-outline-variant">

                <div>

                    <span class="material-symbols-outlined text-7xl mb-6 text-primary">
                        inventory_2
                    </span>

                    <h2 class="text-3xl font-bold mb-4 text-on-surface">
                        Produtos
                    </h2>

                    <p class="text-lg text-on-surface-variant leading-relaxed">
                        Gerencie estoque, consulte produtos e registre novos itens.
                    </p>

                </div>

            </a>

            <!-- MOVIMENTAÇÃO CAIXA -->
            <a href="/Admin/MovimentacaoCaixa"
                class="bg-surface-container-lowest rounded-3xl p-10 min-h-[280px] flex flex-col justify-between hover:scale-105 transition-all duration-300 shadow-xl border border-outline-variant">

                <div>

                    <span class="material-symbols-outlined text-7xl mb-6 text-primary">
                        payments
                    </span>

                    <h2 class="text-3xl font-bold mb-4 text-on-surface">
                        Movimentação Caixa
                    </h2>

                    <p class="text-lg text-on-surface-variant leading-relaxed">
                        Controle entradas, saídas e acompanhe todo o histórico financeiro diário.
                    </p>

                </div>

            </a>

            <!-- RELATÓRIO FINANCEIRO -->
            <a href="/Admin/RelatorioFinanceiro"
                class="bg-surface-container-lowest rounded-3xl p-10 min-h-[280px] flex flex-col justify-between hover:scale-105 transition-all duration-300 shadow-xl border border-outline-variant">

                <div>

                    <span class="material-symbols-outlined text-7xl mb-6 text-primary">
                        monitoring
                    </span>

                    <h2 class="text-3xl font-bold mb-4 text-on-surface">
                        Relatório Financeiro
                    </h2>

                    <p class="text-lg text-on-surface-variant leading-relaxed">
                        Visualize lucros, faturamento e gastos por período selecionado.
                    </p>

                </div>

            </a>

            <!-- CLIENTES -->
            <a href="/Admin/Clientes"
                class="bg-surface-container-lowest rounded-3xl p-10 min-h-[280px] flex flex-col justify-between hover:scale-105 transition-all duration-300 shadow-xl border border-outline-variant">

                <div>

                    <span class="material-symbols-outlined text-7xl mb-6 text-primary">
                        group
                    </span>

                    <h2 class="text-3xl font-bold mb-4 text-on-surface">
                        Clientes
                    </h2>

                    <p class="text-lg text-on-surface-variant leading-relaxed">
                        Consulte clientes cadastrados e visualize informações completas.
                    </p>

                </div>

            </a>

            <!-- NOVA VIAGEM -->
            <a href="/Admin/Viagem"
                class="bg-surface-container-lowest rounded-3xl p-10 min-h-[280px] flex flex-col justify-between hover:scale-105 transition-all duration-300 shadow-xl border border-outline-variant">

                <div>

                    <span class="material-symbols-outlined text-7xl mb-6 text-primary">
                        travel
                    </span>

                    <h2 class="text-3xl font-bold mb-4 text-on-surface">
                        Nova Viagem
                    </h2>

                    <p class="text-lg text-on-surface-variant leading-relaxed">
                        Registre custos de viagens, compras e acompanhe margem de lucro.
                    </p>

                </div>

            </a>

        </div>
        <!-- Secondary Information Section -->
        <section class="mt-stack-lg grid grid-cols-1 lg:grid-cols-2 gap-gutter">
            <div class="bg-surface-container-low rounded-xl p-stack-md">
                <h3 class="font-headline-md mb-6 border-b border-outline-variant pb-4">Ações Recentes</h3>
                <div class="space-y-4">
                    <div class="flex items-center justify-between py-2 border-b border-surface-container">
                        <div class="flex items-center gap-4">
                            <span class="w-2 h-2 rounded-full bg-primary"></span>
                            <p class="text-body-md">Venda #1024 finalizada (Pix)</p>
                        </div>
                        <span class="text-xs text-outline font-body-md">Agora</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-surface-container">
                        <div class="flex items-center gap-4">
                            <span class="w-2 h-2 rounded-full bg-secondary"></span>
                            <p class="text-body-md">Ajuste de estoque: Bolsa Marfim</p>
                        </div>
                        <span class="text-xs text-outline font-body-md">15 min</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-surface-container">
                        <div class="flex items-center gap-4">
                            <span class="w-2 h-2 rounded-full bg-outline"></span>
                            <p class="text-body-md">Novo cliente cadastrado: Marina S.</p>
                        </div>
                        <span class="text-xs text-outline font-body-md">1h atrás</span>
                    </div>
                </div>
            </div>
            <div
                class="bg-surface-container-low rounded-xl p-stack-md flex flex-col justify-center items-center text-center">
                <div class="mb-4">
                    <span class="material-symbols-outlined text-4xl text-outline-variant">support_agent</span>
                </div>
                <h3 class="font-headline-md mb-2">Suporte do Sistema</h3>
                <p class="text-body-md text-on-surface-variant mb-6 max-w-sm">Precisa de ajuda com alguma funcionalidade
                    ou deseja sugerir uma melhoria?</p>
                <button
                    class="border border-primary text-primary font-label-caps py-3 px-8 rounded text-[11px] uppercase tracking-widest hover:bg-primary hover:text-white transition-all duration-300">
                    Falar com Suporte
                </button>
            </div>
        </section>
    </main>
    <script>
        // Set current date
        const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const today = new Date();
        document.getElementById('current-date').innerText = today.toLocaleDateString('pt-BR', dateOptions);

        // Micro-interactions for cards
        const cards = document.querySelectorAll('.admin-card-shadow');
        cards.forEach(card => {
            card.addEventListener('mouseenter', () => {
                // Potential subtle hover logic
            });
        });
    </script>
</body>

</html>