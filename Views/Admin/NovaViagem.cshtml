@model List<PaulaPresentesWebMVC.Models.Viagem>

@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Viagens</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: "#570013",
                        surface: "#f9f9f9",
                        card: "#ffffff",
                        border: "#e5e5e5"

                    }

                }

            }

        }

    </script>

</head>

<body class="bg-surface font-[Inter] min-h-screen">

    <!-- HEADER -->
    <header class="bg-white border-b border-border px-10 py-6 flex justify-between items-center">

        <div>

            <h1 class="text-4xl font-bold text-primary">
                Controle de Viagens
            </h1>

            <p class="text-gray-500 mt-2">
                Gestão de custos e compras das viagens
            </p>

        </div>

        <a href="/Admin"
           class="bg-primary text-white px-6 py-4 rounded-2xl font-semibold hover:opacity-90 transition">

            Voltar

        </a>

    </header>

    <main class="max-w-7xl mx-auto p-10">

        <!-- FILTROS -->
        <div class="bg-card rounded-3xl shadow-xl p-8 mb-10">

            <div class="flex items-center gap-3 mb-8">

                <span class="material-symbols-outlined text-4xl text-primary">
                    filter_alt
                </span>

                <h2 class="text-3xl font-bold">
                    Filtrar Viagens
                </h2>

            </div>

            <form method="get"
                  action="/Admin/NovaViagem">

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

                    <!-- DATA INICIAL -->
                    <div>

                        <label class="font-semibold">
                            Data Inicial
                        </label>

                        <input type="date"
                               name="dataInicial"
                               class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                    </div>

                    <!-- DATA FINAL -->
                    <div>

                        <label class="font-semibold">
                            Data Final
                        </label>

                        <input type="date"
                               name="dataFinal"
                               class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                    </div>

                    <!-- FILTRO PRONTO -->
                    <div>

                        <label class="font-semibold">
                            Período
                        </label>

                        <select name="periodo"
                                class="w-full border border-gray-300 rounded-2xl p-4 mt-3">

                            <option value="">
                                Todos
                            </option>

                            <option value="mes">
                                Último Mês
                            </option>

                            <option value="semestre">
                                Últimos 6 Meses
                            </option>

                            <option value="ano">
                                Último Ano
                            </option>

                        </select>

                    </div>

                    <!-- BOTÃO -->
                    <div class="flex items-end">

                        <button class="bg-primary text-white w-full py-4 rounded-2xl font-bold hover:opacity-90 transition">

                            Filtrar

                        </button>

                    </div>

                </div>

            </form>

        </div>

        <!-- DASHBOARDS -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">

            <!-- TOTAL VIAGENS -->
            <div class="bg-white rounded-3xl p-8 shadow-xl">

                <p class="text-gray-500">
                    Total de Viagens
                </p>

                <h2 class="text-5xl font-bold mt-4 text-primary">

                    @Model.Count

                </h2>

            </div>

            <!-- CUSTO TOTAL -->
            <div class="bg-white rounded-3xl p-8 shadow-xl">

                <p class="text-gray-500">
                    Custo Total
                </p>

                <h2 class="text-4xl font-bold mt-4 text-red-600">

                    R$ @Model.Sum(v => v.CustoTotal).ToString("N2")

                </h2>

            </div>

            <!-- TOTAL COMPRAS -->
            <div class="bg-white rounded-3xl p-8 shadow-xl">

                <p class="text-gray-500">
                    Total Compras
                </p>

                <h2 class="text-4xl font-bold mt-4 text-green-600">

                    R$ @Model.Sum(v => v.ValorTotalCompra).ToString("N2")

                </h2>

            </div>

            <!-- MÉDIA -->
            <div class="bg-white rounded-3xl p-8 shadow-xl">

                <p class="text-gray-500">
                    Média por Viagem
                </p>

                <h2 class="text-4xl font-bold mt-4 text-primary">

                    R$
                    @(Model.Count > 0
                        ? (Model.Sum(v => v.CustoTotal) / Model.Count).ToString("N2")
                        : "0,00")

                </h2>

            </div>

        </div>

        <!-- NOVA VIAGEM -->
        <div class="bg-white rounded-3xl shadow-xl p-10 mb-10">

            <div class="flex items-center gap-3 mb-8">

                <span class="material-symbols-outlined text-4xl text-primary">
                    add_circle
                </span>

                <h2 class="text-3xl font-bold">
                    Nova Viagem
                </h2>

            </div>

            <form method="post"
                  action="/Admin/SalvarViagem">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <!-- DATA -->
                    <div>

                        <label class="font-semibold">
                            Data da Viagem
                        </label>

                        <input type="date"
                               name="DataViagem"
                               required
                               class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                    </div>

                    <!-- IDA E VOLTA -->
                    <div>

                        <label class="font-semibold">
                            Custo Ida e Volta
                        </label>

                        <input type="number"
                               step="0.01"
                               name="CustoIdaVolta"
                               required
                               class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                    </div>

                    <!-- ALIMENTAÇÃO -->
                    <div>

                        <label class="font-semibold">
                            Custo Alimentação
                        </label>

                        <input type="number"
                               step="0.01"
                               name="CustoAlimentacao"
                               required
                               class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                    </div>

                    <!-- COMPRAS -->
                    <div>

                        <label class="font-semibold">
                            Valor Total Compras
                        </label>

                        <input type="number"
                               step="0.01"
                               name="ValorTotalCompra"
                               required
                               class="w-full border border-gray-300 rounded-2xl p-4 mt-3" />

                    </div>

                </div>

                <button class="w-full bg-primary text-white py-5 rounded-2xl mt-10 text-xl font-bold hover:opacity-90 transition">

                    Salvar Viagem

                </button>

            </form>

        </div>

        <!-- HISTÓRICO -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden">

            <div class="p-8 border-b">

                <h2 class="text-3xl font-bold">
                    Histórico de Viagens
                </h2>

            </div>

            <table class="w-full">

                <thead class="bg-primary text-white">

                    <tr>

                        <th class="p-6 text-left">
                            Data
                        </th>

                        <th class="p-6 text-left">
                            Ida e Volta
                        </th>

                        <th class="p-6 text-left">
                            Alimentação
                        </th>

                        <th class="p-6 text-left">
                            Compras
                        </th>

                        <th class="p-6 text-left">
                            Custo Total
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="border-b hover:bg-gray-50 transition">

                            <td class="p-6 font-semibold">

                                @item.DataViagem.ToString("dd/MM/yyyy")

                            </td>

                            <td class="p-6">

                                R$ @item.CustoIdaVolta.ToString("N2")

                            </td>

                            <td class="p-6">

                                R$ @item.CustoAlimentacao.ToString("N2")

                            </td>

                            <td class="p-6 text-green-600 font-bold">

                                R$ @item.ValorTotalCompra.ToString("N2")

                            </td>

                            <td class="p-6 text-xl font-bold text-primary">

                                R$ @item.CustoTotal.ToString("N2")

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </main>

</body>

</html>