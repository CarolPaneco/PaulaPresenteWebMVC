            <div class="relative z-20 text-center text-white px-4">
                <span class="uppercase tracking-[0.3em] mb-4 block">Coleção Exclusiva</span>
                <h1 class="text-5xl md:text-7xl mb-8">A Arte de Presentear</h1>
            </div>
        </div>

        <!-- SLIDE 2 -->
        <div class="min-w-full relative flex items-center justify-center bg-neutral-900">
            <div class="absolute inset-0 bg-black/30 z-10"></div>

            <img class="absolute inset-0 w-full h-full object-cover"
                src="https://images.unsplash.com/photo-1542291026-7eec264c27ff" />

            <div class="relative z-20 text-center text-white px-4">
                <span class="uppercase tracking-[0.3em] mb-4 block">Elegância</span>
                <h1 class="text-5xl md:text-7xl mb-8">Estilo Atemporal</h1>
            </div>
        </div>

        <!-- SLIDE 3 -->
        <div class="min-w-full relative flex items-center justify-center bg-neutral-900">
            <div class="absolute inset-0 bg-black/30 z-10"></div>

            <img class="absolute inset-0 w-full h-full object-cover"
                src="https://images.unsplash.com/photo-1521335629791-ce4aec67dd53" />

            <div class="relative z-20 text-center text-white px-4">
                <span class="uppercase tracking-[0.3em] mb-4 block">Luxo</span>
                <h1 class="text-5xl md:text-7xl mb-8">Detalhes que encantam</h1>
            </div>
        </div>

    </div>

    <!-- BOTÕES -->
    <button onclick="prevSlide()" class="absolute left-6 top-1/2 -translate-y-1/2 text-white text-3xl z-40">
        ❮
    </button>

    <button onclick="nextSlide()" class="absolute right-6 top-1/2 -translate-y-1/2 text-white text-3xl z-40">
        ❯
    </button>

    <!-- INDICADORES -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 z-30 flex gap-4">
        <div class="dot w-12 h-[2px] bg-white"></div>
        <div class="dot w-12 h-[2px] bg-white/30"></div>
        <div class="dot w-12 h-[2px] bg-white/30"></div>
    </div>

</div>

<script>
    let index = 0;
    const carousel = document.getElementById("carousel");
    const total = carousel.children.length;
    const dots = document.querySelectorAll(".dot");

    function updateCarousel() {
        carousel.style.transform = `translateX(-${index * 100}%)`;

        dots.forEach((dot, i) => {
            dot.classList.remove("bg-white");
            dot.classList.add("bg-white/30");

            if (i === index) {
                dot.classList.remove("bg-white/30");
                dot.classList.add("bg-white");
            }
        });
    }

    function nextSlide() {
        index = (index + 1) % total;
        updateCarousel();
    }

    function prevSlide() {
        index = (index - 1 + total) % total;
        updateCarousel();
    }

    // AUTO PLAY
    setInterval(nextSlide, 5000);
</script>

<main class="w-full px-16 mt-stack-lg mb-stack-lg flex gap-gutter">


