<div class="mt-stack-lg flex flex-col items-center gap-6">

    <p class="font-label-caps text-[10px] text-neutral-400">
        EXIBINDO <span id="contador">12</span> DE @Model.Count PRODUTOS
    </p>

    <div class="w-full max-w-xs h-[1px] bg-neutral-200">
        <div id="barra" class="h-full bg-primary" style="width:16%"></div>
    </div>

    <button id="btnToggle" onclick="mostrarMais()"
            class="px-6 sm:px-10 lg:px-16 py-3 sm:py-4 border border-primary text-primary font-label-caps tracking-widest hover:bg-primary hover:text-white transition-all duration-500">
        VER MAIS
    </button>

</div>
<script>

    let quantidadeVisivel = 12;

    function mostrarMais() {

        quantidadeVisivel += 12;

        const produtos = document.querySelectorAll(".produto");

        produtos.forEach((produto, index) => {

            if (index < quantidadeVisivel) {

                produto.classList.remove("hidden");

            }

        });

        // Atualiza contador
        const contador = document.getElementById("contador");

        if (contador) {

            contador.innerText =
                Math.min(quantidadeVisivel, produtos.length);

        }

        // Atualiza barra
        const barra = document.getElementById("barra");

        if (barra) {

            let porcentagem =
                (Math.min(quantidadeVisivel, produtos.length)
                    / produtos.length) * 100;

            barra.style.width = porcentagem + "%";

        }

        // Esconde botão quando acabar
        if (quantidadeVisivel >= produtos.length) {

            document.getElementById("btnToggle").style.display = "none";

        }

    }

    function filtrarCategoria(categoria) {

        if (!categoria) {
            window.location.href = "/";
            return;
        }

        window.location.href = "/Home?categoria=" + encodeURIComponent(categoria);
    }

</script>
</section>
