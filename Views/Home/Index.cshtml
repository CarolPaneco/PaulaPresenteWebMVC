    <!-- PRODUTOS -->
    <section class="flex-1">

        <div class="flex justify-between items-end mb-12">
            <h2 class="font-display-lg text-display-lg text-red-900">Novidades</h2>
        </div>

        <!-- GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-x-gutter gap-y-12">

            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];

                <div class="produto group relative flex flex-col @(i >= 8 ? "hidden" : "")">

                    <a href="/Produto/Detalhes/@item.IdProduto">

                        <div class="aspect-[3/4] overflow-hidden bg-surface-container-low mb-4 relative">

                            <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                src="@(item.Imagens != null && item.Imagens.Any()
                                                                                        ? "/images/produtos/" + item.Imagens.First().CaminhoImagem
                                                                                        : "/images/produto.jpg")" />

                    </div>

                    <div class="flex flex-col gap-1">

                        <span class="font-label-caps text-[10px] text-neutral-400 uppercase tracking-widest">
                            @item.Categoria
                        </span>

                        <h3 class="font-headline-md text-body-lg text-red-900">
                            @(string.IsNullOrEmpty(item.Nome) ? "Produto" : item.Nome)
                        </h3>

                        <p class="font-body-md text-on-surface font-medium">
                            @(item.PrecoVenda != null ? $"R$ {item.PrecoVenda}" : "Preço indisponível")
                        </p>

                    </div>

                </a>

            </div>
                        }
        </div>

    </section>
</main>

<div class="mt-stack-lg flex flex-col items-center gap-6">

    <p class="font-label-caps text-[10px] text-neutral-400">
        EXIBINDO <span id="contador">8</span> DE @Model.Count PRODUTOS
    </p>

    <div class="w-full max-w-xs h-[1px] bg-neutral-200">
        <div id="barra" class="h-full bg-primary" style="width:16%"></div>
    </div>

    <button id="btnToggle"
        class="px-16 py-4 border border-primary text-primary font-label-caps tracking-widest hover:bg-primary hover:text-white transition-all duration-500">
        VER MAIS
    </button>

</div>
<script>
    let visiveis = 8;
    const incremento = 8;

    const produtos = document.querySelectorAll(".produto");
    const total = produtos.length;

    const botao = document.getElementById("btnToggle");
    const contador = document.getElementById("contador");
    const barra = document.getElementById("barra");

    botao.addEventListener("click", () => {

        if (visiveis < total) {
            // MOSTRAR MAIS
            visiveis += incremento;

            produtos.forEach((p, i) => {
                if (i < visiveis) p.classList.remove("hidden");
            });

            if (visiveis >= total) {
                botao.textContent = "VER MENOS";
                visiveis = total;
            }

        } else {
            // VOLTAR PARA 8
            visiveis = 8;

            produtos.forEach((p, i) => {
                if (i >= visiveis) p.classList.add("hidden");
            });

            botao.textContent = "VER MAIS";
        }

        // Atualiza contador
        contador.textContent = visiveis;

        // Atualiza barra
        let porcentagem = (visiveis / total) * 100;
        barra.style.width = porcentagem + "%";
    });
</script>
</section>
