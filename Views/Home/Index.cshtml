@model List<PaulaPresentesWebMVC.Models.Produto>

<div class="relative w-full h-[870px] overflow-hidden">
    <div id="carousel" class="flex h-full transition-transform duration-700 ease-in-out">

        <!-- SLIDE 1 -->
