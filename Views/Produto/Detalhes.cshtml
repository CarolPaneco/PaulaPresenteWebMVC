@model PaulaPresentesWebMVC.Models.Produto

<main class="pt-10 max-w-[1440px] mx-auto px-16">

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-16">

        <!-- GALERIA -->
        <div class="lg:col-span-7 flex flex-col md:flex-row gap-4">

            <!-- THUMBNAILS -->
            <div class="flex md:flex-col gap-4 overflow-auto max-h-[500px]">

                @if (Model.Imagens != null && Model.Imagens.Any())
                {
                    foreach (var img in Model.Imagens)
                    {
                        <div class="w-20 h-24 border overflow-hidden">
                            <img src="/img/produtos/@img.CaminhoImagem" class="w-full h-full object-cover" />
                        </div>
                    }
                }
                else
                {
                    <div class="w-20 h-24 border overflow-hidden">
                        <img src="/images/produto.jpg" class="w-full h-full object-cover" />
                    </div>
                }

            </div>

            <!-- IMAGEM PRINCIPAL -->
            <div class="flex-1 aspect-[4/5] bg-gray-100 overflow-hidden">

                <img src="@(Model.Imagens != null && Model.Imagens.Any()
                ? "/img/produtos/" + Model.Imagens.First().CaminhoImagem
                : "/images/produto.jpg")"
                class="w-full h-full object-cover" />

            </div>

        </div>


        <!-- INFO -->
        <div class="lg:col-span-5 flex flex-col gap-6">

            <div>
                <p class="text-sm text-gray-400 uppercase">@Model.Marca</p>

                <h1 class="text-3xl font-semibold text-red-900">
                    @(string.IsNullOrEmpty(Model.Nome) ? "Produto" : Model.Nome)
                </h1>

                <p class="text-gray-500 mt-2">
                    @(string.IsNullOrEmpty(Model.Descricao) ? "Sem descrição" : Model.Descricao)
                </p>
            </div>

            <!-- PREÇO -->
            <div class="border-y py-4">

                <p class="text-2xl font-bold text-red-900">
                    @(Model.PrecoVenda != null ? $"R$ {Model.PrecoVenda}" : "Preço indisponível")
                </p>

                @{
                    int parcelas = 1;
                    decimal valorParcela = 0;

                    if (Model.PrecoVenda != null)
                    {
                        decimal preco = Model.PrecoVenda.Value;

                        parcelas = (int)(preco / 50);
                        if (parcelas < 1) parcelas = 1;
                        if (parcelas > 10) parcelas = 10;

                        valorParcela = preco / parcelas;
                    }
                }

                @if (Model.PrecoVenda != null)
                {
                    <p class="text-sm text-gray-500">
                        Ou em até @parcelas x de R$ @valorParcela.ToString("F2") sem juros
                    </p>
                }

            </div>

            <!-- VARIAÇÕES -->
            <div>


                <div class="flex flex-wrap gap-2">

                    @if (ViewBag.Variacoes != null && ViewBag.Variacoes.Count > 0)
                    {
                        <div>
                            <p class="text-sm mb-2">Cor:</p>

                            <div class="flex flex-wrap gap-2">

                                <!-- PRODUTO ATUAL -->
                                <span class="px-3 py-1 border rounded-full text-sm bg-black text-white">
                                    @Model.Cor
                                </span>

                                <!-- OUTRAS CORES -->
                                @foreach (var v in ViewBag.Variacoes)
                                {
                                    <a href="/Produto/Detalhes/@v.IdProduto" class="px-3 py-1 border rounded-full text-sm bg-white text-black hover:bg-gray-100
                                                                ">

                                        @v.Cor

                                    </a>
                                }

                            </div>
                        </div>
                    }

                </div>
            </div>

            <form method="post" action="/Carrinho/Adicionar" class="flex flex-col gap-4 pt-4">

                <input type="hidden" name="produtoId" value="@Model.IdProduto" />

                <!-- QUANTIDADE -->

                <p id="avisoEstoque" class="text-sm text-red-900 mt-2 hidden"></p>
                <div class="flex gap-4">

                    @{
                        var estoqueDisponivel = Model?.QuantidadeEstoque ?? 0;
                    }

                    <div class="flex items-center border border-neutral-300 rounded">

                        <button type="button" onclick="diminuirQtd()" class="px-4 py-3 hover:bg-neutral-100">
                            -
                        </button>

                        <input type="text" id="quantidade" name="quantidade" value="1" data-estoque="@estoqueDisponivel"
                            class="w-12 text-center outline-none font-medium" readonly />

                        <button type="button" onclick="aumentarQtd()" class="px-4 py-3 hover:bg-neutral-100">
                            +
                        </button>



                    </div>

                    <!-- ADD CARRINHO -->
                    <button type="submit"
                        class="flex-1 bg-red-900 text-white font-label-caps text-sm tracking-widest py-4 hover:opacity-90 transition uppercase">
                        Adicionar ao carrinho
                    </button>

                </div>

                <!-- COMPRAR AGORA -->
                <button  onclick="enviarWhatsApp()" type="button"
                    class="w-full border border-black py-4 font-label-caps text-sm tracking-widest hover:bg-black hover:text-white transition uppercase">
                    Comprar agora
                </button>

            </form>

        </div>

    </section>

    <!-- Related Products -->
    <section class="mt-stack-lg pt-stack-lg border-t border-neutral-100">

        @{
            var relacionados = ViewBag.Relacionados as List<PaulaPresentesWebMVC.Models.Produto>;
        }

        @if (relacionados != null && relacionados.Any())
        {
            <section class="mt-stack-lg pt-stack-lg border-t border-neutral-100">

                <h2 class="font-headline-lg text-headline-lg text-center mb-12">
                    Pode combinar com
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">

                    @foreach (var item in relacionados)
                    {
                        if (item.IdProduto == Model.IdProduto || item.Cor != Model.Cor)
                        {
                            continue;
                        }

                        <div class="group cursor-pointer">

                            <a href="/Produto/Detalhes/@item.IdProduto">

                                <div class="relative aspect-[3/4] overflow-hidden mb-4 bg-surface-container-low">

                                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                        src="@(item.Imagens != null && item.Imagens.Any()
                                        ? "/img/produtos/" + item.Imagens.First().CaminhoImagem
                                        : "/images/produto.jpg")"
                                        class="w-full h-72 object-cover rounded-2xl mb-6" />
                                    <div
                                        class="absolute bottom-0 left-0 right-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300 bg-white/90 backdrop-blur-sm">

                                        <button type="button" onclick="window.location.href='/Produto/Detalhes/@item.IdProduto'"
                                            class="w-full py-2 bg-primary-container text-white text-[10px] uppercase tracking-widest">

                                            Espiada Rápida

                                        </button>

                                    </div>

                                </div>

                                <p class="text-[10px] text-neutral-400 mb-1 uppercase">
                                    @item.Categoria
                                </p>

                                <h3 class="text-base mb-1 text-red-900">
                                    @(string.IsNullOrEmpty(item.Nome) ? "Produto" : item.Nome)
                                </h3>

                                <p class="font-medium">
                                    @(item.PrecoVenda != null ? $"R$ {item.PrecoVenda}" : "Preço indisponível")
                                </p>

                            </a>

                        </div>
                    }

                </div>

            </section>
        }

        </div>

    </section>

</main>



<script>
    function aumentarQtd() {
        let input = document.getElementById("quantidade");
        let aviso = document.getElementById("avisoEstoque");

        let estoque = parseInt(input.getAttribute("data-estoque"));
        let atual = parseInt(input.value);

        if (atual < estoque) {
            input.value = atual + 1;

            // esconde aviso se estiver ok
            aviso.classList.add("hidden");
            aviso.innerText = "";
        } else {
            aviso.innerText = "Somente " + estoque + " peça(s) em estoque";
            aviso.classList.remove("hidden");
        }
    }

    function diminuirQtd() {
        let input = document.getElementById("quantidade");
        let aviso = document.getElementById("avisoEstoque");

        let atual = parseInt(input.value);

        if (atual > 1) {
            input.value = atual - 1;

            // remove aviso ao diminuir
            aviso.classList.add("hidden");
            aviso.innerText = "";
        }
    }

    
    function enviarWhatsApp() {

        let telefone = "5517991672947";

        let quantidade = parseInt(document.getElementById("quantidade").value);
        let preco = @Model.PrecoVenda;
        let total = quantidade * preco;

        let mensagem =
            "🛍️ Novo Pedido - Paula Presentes\n\n" +

            "👜 @Model.Nome\n" +
            "Quantidade: " + quantidade + "\n" +
            "Preço: R$ " + preco.toFixed(2) + "\n" +
            "Subtotal: R$ " + total.toFixed(2) + "\n\n" +

            "💰 Total: R$ " + total.toFixed(2);

        let url =
            "https://wa.me/" + telefone +
            "?text=" + encodeURIComponent(mensagem);

        window.open(url, "_blank");
    }
</script>
