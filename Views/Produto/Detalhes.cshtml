@model PaulaPresentesWebMVC.Models.Produto

<main class="pt-6 sm:pt-10 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-16">

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">

        <!-- GALERIA -->
        <div class="lg:col-span-7 flex flex-col md:flex-row gap-4">

            <!-- THUMBNAILS -->
            <div class="flex md:flex-col gap-3 overflow-x-auto md:overflow-y-auto md:max-h-[500px]">

                @if (Model.Imagens != null && Model.Imagens.Any())
                {
                    foreach (var img in Model.Imagens)
                    {
                        <div class="w-16 sm:w-20 h-20 sm:h-24 border overflow-hidden rounded-lg flex-shrink-0">
                            <img src="@img.CaminhoImagem"
                        class="w-full h-full object-cover" />
                        </div>
                    }
                }
                else
                {
                    <div class="w-16 sm:w-20 h-20 sm:h-24 border overflow-hidden rounded-lg flex-shrink-0">
                        <img src="/images/produto.jpg"
                             class="w-full h-full object-cover" />
                    </div>
                }

            </div>

            <!-- IMAGEM PRINCIPAL -->
            <div class="flex-1 aspect-[4/5] bg-gray-100 overflow-hidden rounded-xl">

                <img src="@(Model.Imagens != null && Model.Imagens.Any()
                ? Model.Imagens.First().CaminhoImagem
                : "/images/produto.jpg")"
                class="w-full h-full object-cover" />

            </div>

        </div>

        <!-- INFO -->
        <div class="lg:col-span-5 flex flex-col gap-5 sm:gap-6">

            <div>
                <p class="text-xs sm:text-sm text-gray-400 uppercase">@Model.Marca</p>

                <h1 class="text-2xl sm:text-3xl font-semibold text-red-900 mt-1">
                    @(string.IsNullOrEmpty(Model.Nome) ? "Produto" : Model.Nome)
                </h1>

                <p class="text-sm sm:text-base text-gray-500 mt-2">
                    @(string.IsNullOrEmpty(Model.Descricao) ? "Sem descrição" : Model.Descricao)
                </p>
            </div>

            <!-- PREÇO -->
            <div class="border-y py-4">

                <p class="text-xl sm:text-2xl font-bold text-red-900">
                    @(Model.PrecoVenda != null ? $"R$ {Model.PrecoVenda:F2}" : "Preço indisponível")
                </p>

                @{
                    int parcelas = 1;
                    decimal valorParcela = 0;

                    if (Model.PrecoVenda != null)
                    {
                        decimal preco = Model.PrecoVenda.Value;

                        parcelas = (int)(preco / 50);
                        if (parcelas < 1) parcelas = 1;
                        if (parcelas > 10) parcelas = 10;

                        valorParcela = preco / parcelas;
                    }
                }

                @if (Model.PrecoVenda != null)
                {
                    <p class="text-xs sm:text-sm text-gray-500 mt-1">
                        Ou em até @parcelas x de R$ @valorParcela.ToString("F2") sem juros
                    </p>
                }

            </div>

            <!-- VARIAÇÕES -->
            @if (ViewBag.Variacoes != null && ViewBag.Variacoes.Count > 0)
            {
                <div>
                    <p class="text-sm mb-2">Cor:</p>

                    <div class="flex flex-wrap gap-2">

                        <span class="px-3 py-1 border rounded-full text-sm bg-black text-white">
                            @Model.Cor
                        </span>

                        @foreach (var v in ViewBag.Variacoes)
                        {
                            <a href="/Produto/Detalhes/@v.IdProduto"
                               class="px-3 py-1 border rounded-full text-sm hover:bg-gray-100">
                                @v.Cor
                            </a>
                        }

                    </div>
                </div>
            }

            <!-- FORM -->
            <form method="post" action="/Carrinho/Adicionar" class="flex flex-col gap-4 pt-2">

                <input type="hidden" name="produtoId" value="@Model.IdProduto" />

                <p id="avisoEstoque" class="text-sm text-red-900 hidden"></p>

                <div class="flex flex-col sm:flex-row gap-4">

                    @{
                        var estoqueDisponivel = Model?.QuantidadeEstoque ?? 0;
                    }

                    <div class="flex items-center border rounded-lg w-fit">

                        <button type="button" onclick="diminuirQtd()" class="px-4 py-2">
                            -
                        </button>

                        <input type="text"
                               id="quantidade"
                               name="quantidade"
                               value="1"
                               data-estoque="@estoqueDisponivel"
                               class="w-12 text-center outline-none"
                               readonly />

                        <button type="button" onclick="aumentarQtd()" class="px-4 py-2">
                            +
                        </button>

                    </div>

                    <button type="submit"
                            class="flex-1 bg-red-900 text-white py-3 sm:py-4 text-xs sm:text-sm uppercase tracking-widest rounded-lg">
                        Adicionar ao carrinho
                    </button>

                </div>

                <button type="button"
                        onclick="enviarWhatsApp()"
                        class="w-full border border-black py-3 sm:py-4 text-xs sm:text-sm uppercase tracking-widest hover:bg-black hover:text-white transition">
                    Comprar agora
                </button>

            </form>

        </div>

    </section>

    <!-- RELACIONADOS -->
    @{
        var relacionados = ViewBag.Relacionados as List<PaulaPresentesWebMVC.Models.Produto>;
    }

    @if (relacionados != null && relacionados.Any())
    {
        <section class="mt-12 sm:mt-16 border-t pt-10">

            <h2 class="text-xl sm:text-3xl font-bold text-center mb-8">
                Pode combinar com
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

                @foreach (var item in relacionados)
                {
                    <div class="group">

                        <a href="/Produto/Detalhes/@item.IdProduto">

                            <div class="aspect-[3/4] overflow-hidden rounded-xl bg-gray-100 mb-3">

                                <img src="@(item.Imagens != null && item.Imagens.Any()
                                    ? item.Imagens.First().CaminhoImagem
                                    : Url.Content("~/images/produto.jpg"))"
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />

                            </div>

                            <p class="text-xs text-gray-400 uppercase">@item.Categoria</p>

                            <h3 class="text-sm sm:text-base font-medium text-red-900">
                                @(string.IsNullOrEmpty(item.Nome) ? "Produto" : item.Nome)
                            </h3>

                            <p class="text-sm font-semibold">
                                @(item.PrecoVenda != null ? $"R$ {item.PrecoVenda}" : "Preço indisponível")
                            </p>

                        </a>

                    </div>
                }

            </div>

        </section>
    }

</main>

<script>
function aumentarQtd() {
    let input = document.getElementById("quantidade");
    let aviso = document.getElementById("avisoEstoque");

    let estoque = parseInt(input.getAttribute("data-estoque"));
    let atual = parseInt(input.value);

    if (atual < estoque) {
        input.value = atual + 1;
        aviso.classList.add("hidden");
    } else {
        aviso.innerText = "Somente " + estoque + " peça(s) em estoque";
        aviso.classList.remove("hidden");
    }
}

function diminuirQtd() {
    let input = document.getElementById("quantidade");
    let aviso = document.getElementById("avisoEstoque");

    let atual = parseInt(input.value);

    if (atual > 1) {
        input.value = atual - 1;
        aviso.classList.add("hidden");
    }
}

function enviarWhatsApp() {

    let telefone = "5517991672947";

    let quantidade = parseInt(document.getElementById("quantidade").value);
    let preco = @Model.PrecoVenda ?? 0;
    let total = quantidade * preco;

    let mensagem =
        "🛍️ Novo Pedido - Paula Presentes\n\n" +
        "@Model.Nome\n" +
        "Quantidade: " + quantidade + "\n" +
        "Preço: R$ " + preco.toFixed(2) + "\n" +
        "Subtotal: R$ " + total.toFixed(2);

    window.open(
        "https://wa.me/" + telefone + "?text=" + encodeURIComponent(mensagem),
        "_blank"
    );
}
</script>