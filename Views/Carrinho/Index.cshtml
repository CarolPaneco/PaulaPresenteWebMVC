@model List<PaulaPresentesWebMVC.Models.CarrinhoItem>

<main class="max-w-[1440px] mx-auto px-16 pt-32 pb-24">

    <header class="mb-12">
        <h1 class="font-display-lg text-display-lg text-primary mb-2">
            Seu Carrinho
        </h1>

        <p class="font-body-md text-on-surface-variant italic">
            Itens selecionados com curadoria para você.
        </p>
    </header>

    @{
        decimal subtotalGeral = 0;
        decimal frete = ViewBag.Frete != null ? (decimal)ViewBag.Frete : 0;

        if (Model != null)
        {
            foreach (var item in Model)
            {
                var preco = item.Produto?.PrecoVenda ?? 0;
                subtotalGeral += preco * item.Quantidade;
            }
        }

        decimal total = subtotalGeral + frete;
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-20">
            <p class="text-on-surface-variant">
                Seu carrinho está vazio 🛒
            </p>
        </div>
    }
    else
    {

        <div class="grid grid-cols-12 gap-gutter">

            <!-- LISTA DE PRODUTOS -->
            <section class="col-span-12 lg:col-span-8 space-y-gutter">

                @foreach (var item in Model)
                {
                    var preco = item.Produto?.PrecoVenda ?? 0;

                    <div class="group flex items-center gap-8 bg-white p-6 rounded-lg shadow-sm border border-neutral-50">

                        <!-- IMAGEM -->
                       <div class="w-32 h-40 bg-surface-container-low overflow-hidden rounded">

                            <img class="w-full h-full object-cover"
                                src="@(item.Produto?.Imagens != null && item.Produto.Imagens.Any()
                                    ? "/img/produtos/" + item.Produto.Imagens.First().CaminhoImagem
                                    : "/images/produto.jpg")" />

                        </div>

                        <!-- INFO -->
                        <div class="flex-grow">

                            <div class="flex justify-between items-start mb-2">

                                <h3 class="font-headline-md text-on-surface">
                                    @item.Produto?.Nome
                                </h3>

                                <!-- REMOVER -->
                                <form method="post" action="/Carrinho/Remover">
                                    <input type="hidden" name="idItem" value="@item.IdItem" />

                                    <button
                                        class="px-3 py-1 text-sm border border-red-600 text-red-600 rounded hover:bg-red-600 hover:text-white transition">
                                        Remover
                                    </button>
                                </form>

                            </div>

                            <p class="font-label-caps text-on-tertiary-container uppercase mb-2">
                                @item.Produto?.Marca
                            </p>

                            <p class="text-sm text-neutral-500 mb-4">
                                Cor: @item.Produto?.Cor
                            </p>

                            <div class="flex justify-between items-center">

                                <!-- QUANTIDADE -->
                                <form method="post" action="/Carrinho/AtualizarQuantidade" class="flex flex-col">

                                    <input type="hidden" name="idItem" value="@item.IdItem" />

                                    <input type="number" name="quantidade" value="@item.Quantidade" min="1"
                                        max="@item.Produto?.QuantidadeEstoque"
                                        class="w-16 border border-outline-variant rounded-full text-center py-1"
                                        onchange="this.form.submit()" />

                                    @if (item.Produto?.QuantidadeEstoque != null && item.Quantidade >= item.Produto.QuantidadeEstoque)
                                    {
                                        <span class="text-xs text-red-900 mt-1">
                                            Máximo em estoque: @item.Produto.QuantidadeEstoque
                                        </span>
                                    }

                                </form>

                                <!-- PREÇO -->
                                <span class="font-headline-md text-primary">
                                    R$ @preco.ToString("F2")
                                </span>

                            </div>

                        </div>

                    </div>
                }

            </section>

            <!-- RESUMO -->
            <aside class="col-span-12 lg:col-span-4">

                <div class="bg-white p-8 rounded-lg shadow-md border border-neutral-50 sticky top-32">

                    <h2 class="font-headline-md text-on-surface mb-8">
                        Resumo do Pedido
                    </h2>

                    <div class="space-y-4 mb-8 text-sm">


                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span>R$ @subtotalGeral.ToString("F2")</span>
                        </div>

                    </div>

                    <!-- TOTAL -->
                    <div class="border-t pt-6 mb-8 flex justify-between">

                        <span class="font-headline-md">
                            Total
                        </span>

                        <span class="text-primary text-xl font-semibold">
                            R$ @total.ToString("F2")
                        </span>

                    </div>

                    <button onclick="enviarWhatsApp()"
                            class="w-full bg-primary text-white py-5 uppercase tracking-widest hover:opacity-90">

                        Finalizar Compra

                    </button>

                    <div class="mt-6 text-center text-xs text-neutral-400">
                        🔒 Pagamento 100% seguro
                    </div>

                </div>

            </aside>

        </div>
    }

    
</main>

<script>

    function enviarWhatsApp() {

        let telefone = "5517991672947";

        let mensagem =
            "🛍️ Novo Pedido - Paula Presentes\n\n";

        @foreach (var item in Model)
        {
            var preco = item.Produto?.PrecoVenda ?? 0;
            var subtotal = preco * item.Quantidade;

            @:mensagem += @Html.Raw(Json.Serialize("👜 " + item.Produto?.Nome + "\n"));
            @:mensagem += @Html.Raw(Json.Serialize("Quantidade: " + item.Quantidade + "\n"));
            @:mensagem += @Html.Raw(Json.Serialize("Preço: R$ " + preco.ToString("F2") + "\n"));
            @:mensagem += @Html.Raw(Json.Serialize("Subtotal: R$ " + subtotal.ToString("F2") + "\n\n"));
        }

        mensagem +=
            @Html.Raw(Json.Serialize("💰 Total: R$ " + total.ToString("F2")));

        let url =
            "https://wa.me/" + telefone +
            "?text=" + encodeURIComponent(mensagem);

        window.open(url, "_blank");
    }

</script>