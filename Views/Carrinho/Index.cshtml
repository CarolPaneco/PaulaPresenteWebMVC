@model List<PaulaPresentesWebMVC.Models.CarrinhoItem>

<main class="max-w-[1440px] mx-auto px-3 sm:px-6 lg:px-16 pt-24 sm:pt-28 pb-16 sm:pb-24">

    <!-- HEADER -->
    <header class="mb-10 sm:mb-12 text-center lg:text-left">

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-primary mb-2">
            Seu Carrinho
        </h1>

        <p class="text-sm sm:text-base text-on-surface-variant italic">
            Itens selecionados com curadoria para você.
        </p>

    </header>

    @{
        decimal subtotalGeral = 0;
        decimal frete = ViewBag.Frete != null ? (decimal)ViewBag.Frete : 0;

        if (Model != null)
        {
            foreach (var item in Model)
            {
                var preco = item.Produto?.PrecoVenda ?? 0;
                subtotalGeral += preco * item.Quantidade;
            }
        }

        decimal total = subtotalGeral + frete;
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-20">
            <p class="text-on-surface-variant">
                Seu carrinho está vazio 🛒
            </p>
        </div>
    }
    else
    {
        <!-- GRID PRINCIPAL -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-8">

            <!-- LISTA -->
            <section class="lg:col-span-8 space-y-6">

                @foreach (var item in Model)
                {
                    var preco = item.Produto?.PrecoVenda ?? 0;

                    <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 bg-white p-4 sm:p-6 rounded-2xl shadow-sm border">

                        <!-- IMAGEM -->
                        <div class="w-full sm:w-32 h-40 bg-surface-container-low overflow-hidden rounded-xl flex-shrink-0">

                            <img class="w-full h-full object-cover"
                                 src="@(item.Produto?.Imagens != null && item.Produto.Imagens.Any()
     ? item.Produto.Imagens.First().CaminhoImagem
         : Url.Content("~/images/produto.jpg"))" />

                        </div>

                        <!-- INFO -->
                        <div class="flex-1 flex flex-col gap-3">

                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">

                                <h3 class="text-lg sm:text-xl font-bold text-on-surface">
                                    @item.Produto?.Nome
                                </h3>

                                <form method="post" action="/Carrinho/Remover">
                                    <input type="hidden" name="idItem" value="@item.IdItem" />

                                    <button class="text-xs sm:text-sm border border-red-600 text-red-600 px-3 py-1 rounded hover:bg-red-600 hover:text-white">
                                        Remover
                                    </button>
                                </form>

                            </div>

                            <p class="text-xs sm:text-sm text-neutral-500">
                                @item.Produto?.Marca
                            </p>

                            <p class="text-xs text-neutral-400">
                                Cor: @item.Produto?.Cor
                            </p>

                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3">

                                <!-- QUANTIDADE -->
                                <form method="post" action="/Carrinho/AtualizarQuantidade" class="flex flex-col">

                                    <input type="hidden" name="idItem" value="@item.IdItem" />

                                    <input type="number" name="quantidade" value="@item.Quantidade" min="1"
                                        max="@item.Produto?.QuantidadeEstoque"
                                        class="w-16 border border-outline-variant rounded-full text-center py-1"
                                        onchange="this.form.submit()" />

                                    @if (item.Produto?.QuantidadeEstoque != null && item.Quantidade >= item.Produto.QuantidadeEstoque)
                                    {
                                        <span class="text-xs text-red-900 mt-1">
                                            Máximo em estoque: @item.Produto.QuantidadeEstoque
                                        </span>
                                    }

                                </form>

                                <!-- PREÇO -->
                                <span class="text-primary font-bold text-lg sm:text-xl">
                                    R$ @preco.ToString("F2")
                                </span>

                            </div>

                        </div>

                    </div>
                }

            </section>

            <!-- RESUMO -->
            <aside class="lg:col-span-4 mt-4 lg:mt-0">

                <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-md border lg:sticky lg:top-28">

                    <h2 class="text-lg sm:text-xl font-bold mb-6">
                        Resumo do Pedido
                    </h2>

                    <div class="space-y-3 text-sm">

                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span>R$ @subtotalGeral.ToString("F2")</span>
                        </div>

                    </div>

                    <!-- TOTAL -->
                    <div class="border-t mt-6 pt-6 flex justify-between">

                        <span class="font-bold text-lg">Total</span>

                        <span class="text-primary text-xl font-bold">
                            R$ @total.ToString("F2")
                        </span>

                    </div>

                    <button onclick="enviarWhatsApp()"
                            class="w-full mt-6 bg-primary text-white py-4 sm:py-5 rounded-xl uppercase tracking-widest hover:opacity-90 text-sm sm:text-base">

                        Finalizar Compra

                    </button>

                    <p class="text-center text-xs text-neutral-400 mt-4">
                        🔒 Pagamento 100% seguro
                    </p>

                </div>

            </aside>

        </div>
    }

</main>

<script>

function enviarWhatsApp() {

    let telefone = "5517991672947";

    let mensagem = "🛍️ Novo Pedido - Paula Presentes\n\n";

    @foreach (var item in Model)
    {
        var preco = item.Produto?.PrecoVenda ?? 0;
        var subtotal = preco * item.Quantidade;

        @:mensagem += "👜 @item.Produto?.Nome\n";
        @:mensagem += "Quantidade: @item.Quantidade\n";
        @:mensagem += "Preço: R$ @preco.ToString("F2")\n";
        @:mensagem += "Subtotal: R$ @subtotal.ToString("F2")\n\n";
    }

    mensagem += "💰 Total: R$ @total.ToString("F2")";

    let url = "https://wa.me/" + telefone + "?text=" + encodeURIComponent(mensagem);

    window.open(url, "_blank");
}

</script>