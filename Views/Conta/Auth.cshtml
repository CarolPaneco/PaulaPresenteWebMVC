@model PaulaPresentesWebMVC.Models.Cliente

@{
    ViewData["Title"] = "Entrar ou Cadastrar";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif&family=Inter&display=swap" rel="stylesheet" />

    <title>Paula Presentes</title>
</head>

<body class="bg-gray-100">

<main class="min-h-screen flex flex-col md:flex-row">

    <!-- 🖼️ LADO ESQUERDO (IMAGEM) -->
    <section class="hidden md:flex md:w-1/2 relative bg-red-900 text-white items-center justify-center">

        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCPMnfKYhOk7LNYfn0gaWGYfcniLDLVrvUvAwIBz7NN2b8OEdUew00B0NTH3-DahTR00IXZabgXp8SvFTJYNbT5D0SVV8ar9kAQoJRDEG5Y78qEbTtWMv1Qa82RgNal5HT8DfImHKdXx75AvtZacwT47VeXwsjfShkTM-pqLZKEHQp_2wQzbI-Dh0DAfHa9eTi6R2tYv_EFlub7-cVCp-NLELpMS672DbSyhC55TQnx3L0Pnlqd1pgNXGDz_U46akEda9N5vp6PuKw"
             class="absolute inset-0 w-full h-full object-cover opacity-70">

        <div class="relative z-10 p-12 max-w-md text-center">
            <h1 class="text-4xl font-serif mb-4">
                Elegância em cada detalhe
            </h1>
            <p class="opacity-90">
                Descubra bolsas sofisticadas e presentes únicos.
            </p>
        </div>

    </section>

    <!-- 🧾 LADO DIREITO -->
    <section class="flex-1 flex items-center justify-center bg-white px-8 py-12">

        <div class="w-full max-w-md">

            <!-- LOGO -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-serif text-red-900">
                    Paula Presentes
                </h1>
            </div>

            <!-- 🔁 BOTÕES -->
            <div class="flex gap-8 border-b mb-8">

                <button type="button" onclick="mostrarLogin()"
                        id="btnLogin"
                        class="pb-2 border-b-2 border-red-900 text-red-900">
                    ENTRAR
                </button>

                <button type="button" onclick="mostrarCadastro()"
                        id="btnCadastro"
                        class="pb-2 border-b-2 border-transparent text-gray-500">
                    CADASTRAR
                </button>

            </div>

            <div id="formLogin">

                <form method="post" action="/Conta/Login" class="space-y-6">

                    <input name="email" type="email" placeholder="E-mail"
                           class="w-full border-b py-3 focus:outline-none" required />

                    <input name="senha" type="password" placeholder="Senha"
                           class="w-full border-b py-3 focus:outline-none" required />

                    @if (ViewBag.ErroLogin != null)
                    {
                        <div class="text-red-500 text-sm text-center">
                            @ViewBag.ErroLogin
                        </div>
                    }

                    <button class="w-full bg-red-900 text-white py-3 hover:bg-red-800">
                        Entrar
                    </button>

                </form>

            </div>

            <!-- 📝 CADASTRO -->
            <div id="formCadastro" style="display:none;">

                <form method="post" action="/Conta/Cadastro" class="space-y-5">

                    <input name="Nome" placeholder="Nome"
                           class="w-full border-b py-3 focus:outline-none" />

                    <input name="Email" type="email" placeholder="E-mail"
                           class="w-full border-b py-3 focus:outline-none" />

                    <input name="Senha" type="password" placeholder="Senha"
                           class="w-full border-b py-3 focus:outline-none" />

                    <input name="Telefone" placeholder="Telefone"
                           class="w-full border-b py-3 focus:outline-none" />

                    <input name="DataNascimento" type="date"
                           class="w-full border-b py-3 focus:outline-none" />

                    @if (ViewBag.ErroCadastro != null)
                    {
                        <div class="text-red-500 text-sm text-center">
                            @ViewBag.ErroCadastro
                        </div>
                    }

                    @if (ViewBag.Sucesso != null)
                    {
                        <div class="text-green-600 text-sm text-center">
                            @ViewBag.Sucesso
                        </div>
                    }

                    <button class="w-full bg-red-900 text-white py-3 hover:bg-red-800">
                        Cadastrar
                    </button>

                </form>

            </div>

        </div>

    </section>

</main>

<script>
    function mostrarLogin() {
        document.getElementById("formLogin").style.display = "block";
        document.getElementById("formCadastro").style.display = "none";

        document.getElementById("btnLogin").classList.add("border-red-900", "text-red-900");
        document.getElementById("btnCadastro").classList.remove("border-red-900", "text-red-900");
    }

    function mostrarCadastro() {
        document.getElementById("formLogin").style.display = "none";
        document.getElementById("formCadastro").style.display = "block";

        document.getElementById("btnCadastro").classList.add("border-red-900", "text-red-900");
        document.getElementById("btnLogin").classList.remove("border-red-900", "text-red-900");
    }

    // 🔥 Mantém aba correta após erro
    window.onload = function () {

        var erroCadastro = '@ViewBag.ErroCadastro';
        var sucesso = '@ViewBag.Sucesso';

        if (erroCadastro || sucesso) {
            mostrarCadastro();
        }
    }
</script>

</body>
</html>