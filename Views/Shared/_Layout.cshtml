<!DOCTYPE html>

<html class="light" lang="pt-br">

<head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>@ViewData["Title"] - Paula Presentes</title>

        <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Noto+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;display=swap"
                rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
                rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
                rel="stylesheet" />
        <script id="tailwind-config">
                tailwind.config = {
                        darkMode: "class",
                        theme: {
                                extend: {
                                        "colors": {
                                                "on-tertiary-container": "#aaa8a3",
                                                "inverse-surface": "#303030",
                                                "tertiary": "#282725",
                                                "on-surface-variant": "#584141",
                                                "on-primary-container": "#ff828a",
                                                "tertiary-container": "#3d3d3a",
                                                "surface": "#f9f9f9",
                                                "on-primary-fixed": "#40000b",
                                                "on-error": "#ffffff",
                                                "primary-fixed": "#ffdada",
                                                "inverse-on-surface": "#f1f1f1",
                                                "tertiary-fixed-dim": "#c8c6c2",
                                                "on-tertiary-fixed": "#1c1c19",
                                                "on-tertiary": "#ffffff",
                                                "surface-tint": "#af2b3e",
                                                "on-primary": "#ffffff",
                                                "surface-container-highest": "#e2e2e2",
                                                "on-secondary": "#ffffff",
                                                "surface-container-lowest": "#ffffff",
                                                "on-secondary-container": "#745c00",
                                                "surface-dim": "#dadada",
                                                "tertiary-fixed": "#e5e2dd",
                                                "on-tertiary-fixed-variant": "#474743",
                                                "primary-fixed-dim": "#ffb3b5",
                                                "on-primary-fixed-variant": "#8e0f28",
                                                "error-container": "#ffdad6",
                                                "secondary": "#735c00",
                                                "error": "#ba1a1a",
                                                "primary-container": "#800020",
                                                "surface-bright": "#f9f9f9",
                                                "on-error-container": "#93000a",
                                                "outline-variant": "#e0bfbf",
                                                "primary": "#570013",
                                                "surface-container": "#eeeeee",
                                                "on-surface": "#1b1b1b",
                                                "on-secondary-fixed": "#241a00",
                                                "surface-variant": "#e2e2e2",
                                                "inverse-primary": "#ffb3b5",
                                                "background": "#f9f9f9",
                                                "surface-container-high": "#e8e8e8",
                                                "surface-container-low": "#f3f3f3",
                                                "on-secondary-fixed-variant": "#574500",
                                                "secondary-container": "#fed65b",
                                                "on-background": "#1b1b1b",
                                                "secondary-fixed-dim": "#e9c349",
                                                "outline": "#8c7071",
                                                "secondary-fixed": "#ffe088"
                                        },
                                        "borderRadius": {
                                                "DEFAULT": "0.25rem",
                                                "lg": "0.5rem",
                                                "xl": "0.75rem",
                                                "full": "9999px"
                                        },
                                        "spacing": {
                                                "margin": "64px",
                                                "gutter": "24px",
                                                "stack-lg": "80px",
                                                "base": "8px",
                                                "stack-sm": "16px",
                                                "container-max": "1440px",
                                                "stack-md": "32px"
                                        },
                                        "fontFamily": {
                                                "label-caps": ["Inter"],
                                                "headline-lg": ["Noto Serif"],
                                                "display-lg": ["Noto Serif"],
                                                "body-lg": ["Inter"],
                                                "headline-md": ["Noto Serif"],
                                                "body-md": ["Inter"]
                                        },
                                        "fontSize": {
                                                "label-caps": ["12px", { "lineHeight": "1", "letterSpacing": "0.1em", "fontWeight": "600" }],
                                                "headline-lg": ["32px", { "lineHeight": "1.2", "fontWeight": "600" }],
                                                "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                                                "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                                                "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "500" }],
                                                "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }]
                                        }
                                },
                        },
                }
        </script>
        <style>
                .material-symbols-outlined {
                        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
                }

                .hide-scrollbar::-webkit-scrollbar {
                        display: none;
                }

                .hide-scrollbar {
                        -ms-overflow-style: none;
                        scrollbar-width: none;
                }
        </style>
</head>

<body
        class="bg-background text-on-background font-body-md selection:bg-primary-container selection:text-on-primary-container">
        <!-- Top Navigation Bar -->
        <nav
                class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md dark:bg-neutral-950/90 border-b border-neutral-100 dark:border-neutral-800 shadow-sm">
                <div class="w-full max-w-[1800px] mx-auto flex justify-between items-center px-10 xl:px-30 h-20">
                        <div class="flex items-center gap-12">
                                <a class="font-['Noto_Serif'] text-2xl font-light tracking-tighter text-red-900 dark:text-red-100"
                                        asp-controller="Home" asp-action="Index">
                                        Paula Presentes
                                </a>
                                @{
                                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

                                        string GetNavClass(string controller, string action)
                                        {
                                                var baseClass = "font-['Noto_Serif'] tracking-wide uppercase text-sm transition-all duration-300 ";

                                                var activeClass = "border-b-2 border-red-900 text-red-900 dark:border-red-500 dark:text-red-500 pb-1";
                                                var inactiveClass = "text-neutral-500 hover:text-red-900 dark:text-neutral-400";

                                                return baseClass + (currentController == controller && currentAction == action
                                                ? activeClass
                                                : inactiveClass);
                                        }
                                }
                                <div class="hidden md:flex gap-8 items-center">

                                        <a class="@GetNavClass("Home","Index")"
                                        asp-controller="Home"
                                        asp-action="Index">
                                                Home
                                        </a>

                                        <a class="font-['Noto_Serif'] tracking-wide uppercase text-sm text-neutral-500 hover:text-red-900 transition-all duration-300">
                                                Bolsas
                                        </a>

                                        <a class="font-['Noto_Serif'] tracking-wide uppercase text-sm text-neutral-500 hover:text-red-900 transition-all duration-300">
                                                Óculos
                                        </a>

                                        <a class="font-['Noto_Serif'] tracking-wide uppercase text-sm text-neutral-500 hover:text-red-900 transition-all duration-300">
                                                Malas
                                        </a>

                                        <a class="font-['Noto_Serif'] tracking-wide uppercase text-sm text-neutral-500 hover:text-red-900 transition-all duration-300">
                                                Presentes
                                        </a>

                                        <a class="@GetNavClass("Home","Sobre")"
                                        asp-controller="Home"
                                        asp-action="Sobre">
                                                Sobre nós
                                        </a>

                                </div>
                        </div>
                <div class="flex items-center gap-6">
                        @if (Context.Session.GetString("UsuarioNome") != null){

                                <a asp-controller="Conta" asp-action="Perfil"
                                        class="scale-100 active:scale-95 transition-transform text-red-900">
                                        <span class="material-symbols-outlined">person</span>
                                        <span>@Context.Session.GetString("UsuarioNome")</span>
                                </a>

                        } else {

                                <a asp-controller="Conta" asp-action="Login"
                                        class="scale-100 active:scale-95 transition-transform text-red-900">
                                        <span class="material-symbols-outlined">person</span>
                                </a>

                        }
                        
                                <a asp-controller="Carrinho" asp-action="Index"
                                        class="scale-100 active:scale-95 transition-transform text-red-900 relative">
                                        <span class="material-symbols-outlined">shopping_bag</span>
                                </a>
                        </div>
                </div>
        </nav>
        <!-- CONTEÚDO DA PÁGINA -->
        <div class="w-full px-16 mt-28">
                @RenderBody()
        </div>
        <!-- Footer -->
        <footer class="w-full border-t border-neutral-100 bg-white dark:bg-neutral-950 mt-20">
                <div class="max-w-[2000px] mx-auto px-16 py-24 flex flex-col items-center gap-12">
                        <div class="font-['Noto_Serif'] text-xl italic text-red-900 dark:text-red-500">Paula Presentes
                        </div>
                        <div class="flex flex-wrap justify-center gap-12">
                                <a class="font-['Noto_Serif'] text-xs uppercase tracking-widest text-neutral-400 hover:text-amber-500 underline-offset-4 hover:underline transition-colors"
                                        href="#">Sobre Nós</a>
                                <a class="font-['Noto_Serif'] text-xs uppercase tracking-widest text-neutral-400 hover:text-amber-500 underline-offset-4 hover:underline transition-colors"
                                        href="#">Envio</a>
                                <a class="font-['Noto_Serif'] text-xs uppercase tracking-widest text-neutral-400 hover:text-amber-500 underline-offset-4 hover:underline transition-colors"
                                        href="#">Trocas e Devoluções</a>
                                <a class="font-['Noto_Serif'] text-xs uppercase tracking-widest text-neutral-400 hover:text-amber-500 underline-offset-4 hover:underline transition-colors"
                                        href="#">Privacidade</a>
                                <a class="font-['Noto_Serif'] text-xs uppercase tracking-widest text-neutral-400 hover:text-amber-500 underline-offset-4 hover:underline transition-colors"
                                        href="#">Contato</a>
                        </div>
                        <div class="flex gap-8 text-neutral-300">
                                <a class="hover:text-primary transition-colors" href="#"><span
                                                class="material-symbols-outlined">brand_family</span></a>
                                <a class="hover:text-primary transition-colors" href="#"><span
                                                class="material-symbols-outlined">share</span></a>
                                <a class="hover:text-primary transition-colors" href="#"><span
                                                class="material-symbols-outlined">mail</span></a>
                        </div>
                        <p class="font-['Noto_Serif'] text-xs uppercase tracking-widest text-neutral-400">© 2024 Paula
                                Presentes. Sophisticated Gifting.</p>
                </div>
        </footer>
</body>

</html>